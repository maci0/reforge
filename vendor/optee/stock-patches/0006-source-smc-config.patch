-/* Reconstructed SMC region programming from original0x41b13adc.
- * Region generation preserves original32KiB minimum and diagnostics. */
-#include <stdint.h>
-#include <string.h>
-#include <trace.h>
-#include <io.h>
-#include <mm/core_memprot.h>
-struct smc_region { uint64_t start; uint64_t size; };
-static void generate_smc_mem_map(uint64_t start, uint64_t size,
-                                 struct smc_region map[16])
-{
-    int index = 0;
-    while (size) {
-        uint64_t block = (uint64_t)1 << 32;
-        int bits;
-        for (bits = 32; bits >= 16; --bits, block >>= 1) {
-            if (size >= block && !(start & (block - 1)))
-                break;
-        }
-        map[index].start = start;
-        map[index].size = block;
-        start += block;
-        if (size < block) {
-            trace_printf(__func__, 106, TRACE_ERROR, true,
-                "TA RAM not SMC align, extra 0x%llx byte mem config secured!",
-                (unsigned long long)(block - size));
-            break;
-        }
-        size -= block;
-        if (!size)
-            break;
-        if (++index == 16) {
-            trace_printf(__func__, 116, TRACE_ERROR, true,
-                "Not enough SMC region, 0x%llx byte ta ram left unsecured",
-                (unsigned long long)size);
-            break;
-        }
-    }
-}
-int sunxi_smc_config(uint64_t start, uint64_t size);
-int sunxi_smc_config(uint64_t start, uint64_t size)
-{
-    struct smc_region map[16];
-    int reg, i;
-    if (!size)
-        return 0;
-    memset(map, 0, sizeof(map));
-    generate_smc_mem_map(start, size, map);
-    for (reg = 0; reg < 16; ++reg) {
-        if (!io_read32((vaddr_t)phys_to_virt_io(0x03007108 + 16 * reg)))
-            break;
-    }
-    if (reg == 16) {
-        trace_printf(__func__, 149, TRACE_ERROR, true,
-                     "no available region for smc config!");
-        return 0;
-    }
-    for (i = 0; reg < 16 && map[i].size; ++reg, ++i) {
-        uint64_t address = map[i].start - 0x40000000;
-        uint64_t scale = map[i].size >> 15;
-        int log = 0;
-        vaddr_t high = (vaddr_t)phys_to_virt_io(0x03007104 + 16 * reg);
-        vaddr_t low = (vaddr_t)phys_to_virt_io(0x03007100 + 16 * reg);
-        vaddr_t attr = (vaddr_t)phys_to_virt_io(0x03007108 + 16 * reg);
-        io_write32(high, address >> 32);
-        io_write32(low, (uint32_t)address & 0xffff8000);
-        while ((scale >>= 1))
