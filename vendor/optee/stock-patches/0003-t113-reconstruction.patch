@@ -0,0 +1,61 @@
+/* Source reconstruction from original execution/data-flow observations.
+ * Undefined vendor services are deliberate unresolved source obligations,
+ * not empty implementations. No opcodes or original objects are imported. */
+#include <stdint.h>
+#include <string.h>
+#include <tee_api_types.h>
+#include <kernel/panic.h>
+#include <mm/core_mmu.h>
+#include <mm/core_memprot.h>
+#include <platform_config.h>
+register_phys_mem_pgdir(MEM_AREA_IO_SEC, GIC_BASE, CORE_MMU_PGDIR_SIZE);
+register_phys_mem_pgdir(MEM_AREA_IO_SEC, SUNXI_RTC_BASE, 0x400);
+register_phys_mem_pgdir(MEM_AREA_IO_SEC, SUNXI_CPUCFG_BASE, 0x1000);
+register_phys_mem_pgdir(MEM_AREA_IO_SEC, SUNXI_PRCM_BASE, 0x1000);
+register_phys_mem_pgdir(MEM_AREA_IO_SEC, SUNXI_SRAM_BASE, 0x8000);
+/* Concrete vendor ABI recovered from original caller argument registers. */
+void sunxi_gic_cpuif_init(vaddr_t gicc, vaddr_t gicd);
+void sunxi_gic_distributor_init(vaddr_t gicd);
+int check_hardware_info(void);
+void sunxi_hash_install(void);
+int sunxi_secure_bus_init(void);
+int sunxi_smc_config(uint64_t start, uint64_t size);
+void main_init_gic(void);
+TEE_Result plat_init(void);
+vaddr_t gicd_base, gicc_base;
+vaddr_t prcm_base, cpucfg_base, rtc_base;
+void main_init_gic(void)
+{
+    gicc_base = (vaddr_t)phys_to_virt_io(GIC_BASE + GICC_OFFSET);
+    gicd_base = (vaddr_t)phys_to_virt_io(GIC_BASE + GICD_OFFSET);
+    if (!gicc_base || !gicd_base)
+        __do_panic(__FILE__, 219, __func__, NULL);
+    sunxi_gic_cpuif_init(gicc_base, gicd_base);
+    sunxi_gic_distributor_init(gicd_base);
+}
+TEE_Result plat_init(void)
+{
+    vaddr_t sram_base = (vaddr_t)phys_to_virt_io(SUNXI_SRAM_BASE);
+    rtc_base = (vaddr_t)phys_to_virt_io(SUNXI_RTC_BASE);
+    cpucfg_base = (vaddr_t)phys_to_virt_io(SUNXI_CPUCFG_BASE);
+    prcm_base = (vaddr_t)phys_to_virt_io(SUNXI_PRCM_BASE);
+    if (check_hardware_info())
+        __do_panic(__FILE__, 314, __func__, NULL);
+    *(volatile uint32_t *)(rtc_base + 0x144) = 24;
+    *(volatile uint32_t *)(rtc_base + 0x140) = 24;
+    *(volatile uint32_t *)(rtc_base + 0x100) = 0x16aa0000;
+    *(volatile uint32_t *)(rtc_base + 0x100) = 0xaa160001;
+    *(volatile uint32_t *)(rtc_base + 0x10c) = 255;
+    *(volatile uint32_t *)(prcm_base + 0x50) &= ~1u;
+    sunxi_hash_install();
+    memset((void *)sram_base, 0, 0x8000);
+    sunxi_secure_bus_init();
+    return sunxi_smc_config(SUNXI_TA_START, SUNXI_TA_SIZE);
+}
+
+#include <io.h>
+uint32_t sunxi_get_hardware_id(void);
+uint32_t sunxi_get_hardware_id(void)
+{
+    return io_read32((vaddr_t)phys_to_virt_io(0x03006000) + 0x200) & 0xffff;
+}
