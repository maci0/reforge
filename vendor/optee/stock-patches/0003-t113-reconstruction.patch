diff --git a/core/arch/arm/plat-sun8iw20p1/hardware_info.c b/core/arch/arm/plat-sun8iw20p1/hardware_info.c
new file mode 100644
--- /dev/null
+++ b/core/arch/arm/plat-sun8iw20p1/hardware_info.c
@@ -0,0 +1,66 @@
+/* Original hardware-policy algorithm reconstructed from IDA control flow.
+ * This preserves checks; it does not bypass device identification. */
+#include <stdint.h>
+#include <string.h>
+#include <trace.h>
+#include <io.h>
+#include <mm/core_memprot.h>
+struct sunxi_optee_header_prefix {
+    uint8_t prefix[237];
+    uint8_t hardware_flags;
+    uint16_t hardware_magic;
+    uint8_t encoded_ids[4];
+};
+#include <platform_config.h>
+#define tee_spare_head (*(struct sunxi_optee_header_prefix *)CFG_TZDRAM_START)
+uint32_t sunxi_get_hardware_id(void);
+int check_hardware_info(void);
+
+int check_hardware_info(void)
+{
+    uint8_t decoded_ids[4] = { 0 };
+    uint8_t key[16] = { 0x41,0x57,0x55,0xaa,1,2,3,4,4,3,2,1,0xa1,0xb1,0xa3,0xb3 };
+    uint8_t flags;
+    uint16_t magic;
+    uint32_t hardware_id;
+    int i, j, count;
+    flags = tee_spare_head.hardware_flags;
+    magic = tee_spare_head.hardware_magic;
+    hardware_id = sunxi_get_hardware_id();
+    if (!(uint16_t)hardware_id)
+        return 0;
+    count = flags & 0xf;
+    if (magic != 0x5741 || count > 4) {
+        trace_printf(__func__, 90, TRACE_ERROR, true, "hardware check error1\n");
+        return 1;
+    }
+    if ((flags & 0xf0) != 0x50) {
+        trace_printf(__func__, 95, TRACE_ERROR, true, "hardware check error2\n");
+        return 2;
+    }
+    for (i = 0; i < count; ++i) {
+        decoded_ids[i] = tee_spare_head.encoded_ids[i];
+        for (j = 0; j < 16; ++j)
+            decoded_ids[i] ^= key[j];
+    }
+    if (hardware_id & 0xff00) {
+        for (i = 0; i < count; i += 2) {
+            if (decoded_ids[i] == ((hardware_id >> 8) & 0xff) &&
+                decoded_ids[i + 1] == (hardware_id & 0xff)) {
+                trace_printf(__func__, 110, TRACE_DEBUG, true, "check OK\n");
+                return 0;
+            }
+        }
+    } else {
+        for (i = 0; i < count; ++i) {
+            if (hardware_id == decoded_ids[i]) {
+                trace_printf(__func__, 117, TRACE_DEBUG, true, "check OK\n");
+                return 0;
+            }
+        }
+    }
+    trace_printf(__func__, 122, TRACE_ERROR, true, "data: %x %x %x %x\n",
+                 decoded_ids[0], decoded_ids[1], decoded_ids[2], decoded_ids[3]);
+    trace_printf(__func__, 123, TRACE_ERROR, true, "hardware error 3\n");
+    return 3;
+}
diff --git a/core/arch/arm/plat-sun8iw20p1/hash_install.c b/core/arch/arm/plat-sun8iw20p1/hash_install.c
new file mode 100644
--- /dev/null
+++ b/core/arch/arm/plat-sun8iw20p1/hash_install.c
@@ -0,0 +1,36 @@
+/* Source reconstruction of original boot-provided hash-list installation.
+ * Record layout is observed: 16-byte name and32-byte digest, count at0xc0c. */
+#include <stdint.h>
+#include <string.h>
+#include <malloc.h>
+#include <trace.h>
+struct sunxi_hash_entry { char name[16]; uint8_t digest[32]; };
+struct sunxi_hash_header {
+    uint8_t before_boot_info[0xc00];
+    char boot_info_magic[8];
+    uint32_t version;
+    int hash_entries;
+    struct sunxi_hash_entry entries[16];
+};
+#include <platform_config.h>
+#define tee_spare_head (*(struct sunxi_hash_header *)CFG_TZDRAM_START)
+struct sunxi_hash_entry *sunxi_hash_list;
+int sunxi_hash_count;
+void sunxi_hash_install(void);
+void sunxi_hash_install(void)
+{
+    int i;
+    int count = tee_spare_head.hash_entries;
+    sunxi_hash_list = malloc(count * sizeof(struct sunxi_hash_entry));
+    if (!sunxi_hash_list) {
+        trace_printf(__func__, 60, TRACE_DEBUG, true, "malloc failed\n");
+        return;
+    }
+    for (i = 0; i < count; ++i) {
+        trace_printf(__func__, 64, TRACE_INFO, true, "install hash %s\n",
+                     tee_spare_head.entries[i].name);
+        memcpy(sunxi_hash_list[i].name, tee_spare_head.entries[i].name, 16);
+        memcpy(sunxi_hash_list[i].digest, tee_spare_head.entries[i].digest, 32);
+        sunxi_hash_count++;
+    }
+}
diff --git a/core/arch/arm/plat-sun8iw20p1/main.c b/core/arch/arm/plat-sun8iw20p1/main.c
