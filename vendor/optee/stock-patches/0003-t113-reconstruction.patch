+++ b/core/arch/arm/plat-sun8iw20p1/gic.c
@@ -0,0 +1,45 @@
+/* Reconstructed CPU interface writes, confirmed by original IDA at
+ * 0x41b13960. Register definitions agree with published Allwinner ns-gic.c
+ * Git blob28d3e7a8057bfed0516998e3f4cb224ec0ab19c0. */
+#include <stdint.h>
+#include <types_ext.h>
+#include <io.h>
+void sunxi_gic_cpuif_init(vaddr_t gicc_base, vaddr_t gicd_base);
+void sunxi_gic_cpuif_init(vaddr_t gicc_base, vaddr_t gicd_base)
+{
+    io_write32(gicd_base + 0x180, 0xffff0000);
+    io_write32(gicd_base + 0x100, 0x0000ffff);
+    io_write32(gicc_base + 4, 0xf0);
+    io_write32(gicc_base, 0xb);
+}
+
+#include <trace.h>
+void sunxi_gic_distributor_init(vaddr_t gicd_base);
+void sunxi_gic_distributor_init(vaddr_t gicd_base)
+{
+    unsigned int i;
+    unsigned int gic_irqs;
+    io_write32(gicd_base, 0);
+    gic_irqs = ((io_read32(gicd_base + 4) & 0x1f) + 1) * 32;
+    if (gic_irqs > 1020)
+        gic_irqs = 1020;
+    if (gic_irqs < 224) {
+        /* Observed original diagnostic ABI, not generated-file line padding. */
+        trace_printf(__func__, 116, TRACE_DEBUG, true,
+                     "GIC parameter config error\n");
+        return;
+    }
+    for (i = 0; i < 7; ++i)
+        io_write32(gicd_base + 0x80 + 4 * i, 0xffffffff);
+    for (i = 0; i < 14; ++i)
+        io_write32(gicd_base + 0xc00 + 4 * i, 0);
+    for (i = 0; i < 56; ++i)
+        io_write32(gicd_base + 0x400 + 4 * i, 0xa0a0a0a0);
+    for (i = 0; i < 48; ++i)
+        io_write32(gicd_base + 0x820 + 4 * i, 0x01010101);
+    for (i = 0; i < 7; ++i)
+        io_write32(gicd_base + 0x180 + 4 * i, 0xffffffff);
+    for (i = 0; i < 7; ++i)
+        io_write32(gicd_base + 0x380 + 4 * i, 0xffffffff);
+    io_write32(gicd_base, 3);
+}
