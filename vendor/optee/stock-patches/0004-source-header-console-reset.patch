@@ -0,0 +1,48 @@
+/* Reconstructed Allwinner boot header data layout. Fields corroborated by
+ * BSP spl-pub/include/private_tee.h and the original pre-boot image.
+ * The executable branch is authored separately in header_entry.S. */
+#include <stdint.h>
+#include <stddef.h>
+#define IMAGE_BASE 0x41b00000u
+extern const uint32_t ta_pub_key_exponent;
+extern const uint8_t ta_pub_key_modulus[];
+extern const size_t ta_pub_key_modulus_size;
+struct sunxi_hash_entry { uint8_t name[16], hash[32]; };
+struct sunxi_secure_boot_info {
+    uint8_t magic[8];
+    uint32_t version, hash_count;
+    struct sunxi_hash_entry entries[10];
+    uint32_t reserved[131];
+};
+struct sunxi_public_key_descriptor {
+    uint8_t magic[8];
+    uint32_t exponent_offset, exponent_bytes, modulus_offset, modulus_size_offset;
+};
+struct sunxi_header_metadata {
+    uint8_t magic[8];
+    uint32_t dram_size, drm_size, length, optee_length;
+    uint8_t version[8], platform[8];
+    uint32_t dram_para[32];
+    uint8_t expand_magic[8], expand_version[8];
+    uint32_t vdd_cpua, vdd_cpub, vdd_sys, vcc_pll, vcc_io, vdd_res1, vdd_res2;
+    uint32_t pmu_count, pmu_port, pmu_para;
+    uint8_t pmu_id[4], pmu_addr[4], chipinfo[8];
+    struct sunxi_public_key_descriptor public_key;
+    uint32_t reserved[701];
+    struct sunxi_secure_boot_info secure_boot_info;
+};
+_Static_assert(sizeof(struct sunxi_header_metadata) + 4 == 4092, "image header size");
+_Static_assert(offsetof(struct sunxi_header_metadata, chipinfo) + 4 == 236, "chipinfo ABI");
+_Static_assert(offsetof(struct sunxi_header_metadata, public_key) + 4 == 244, "public key ABI");
+_Static_assert(offsetof(struct sunxi_header_metadata, secure_boot_info) + 4 == 3072, "secure boot ABI");
+const struct sunxi_header_metadata sunxi_header_metadata
+    __attribute__((section(".text.sunxi_header_metadata"), aligned(4))) = {
+    .magic = "optee", .version = "3.7", .platform = "CHKv1.0",
+    .dram_para = { IMAGE_BASE },
+    .public_key = { .magic = "AW_PUBK!",
+        .exponent_offset = (uint32_t)&ta_pub_key_exponent - IMAGE_BASE,
+        .exponent_bytes = sizeof(ta_pub_key_exponent),
+        .modulus_offset = (uint32_t)ta_pub_key_modulus - IMAGE_BASE,
+        .modulus_size_offset = (uint32_t)&ta_pub_key_modulus_size - IMAGE_BASE },
+    .secure_boot_info = { .magic = "BootInfo", .version = 1 },
+};
--- /dev/null
+++ b/core/arch/arm/plat-sun8iw20p1/header_entry.S
@@ -0,0 +1,11 @@
+/* ARM entry branch targeting the end of the actual 4092-byte header.
+ * The next instruction region is naturally aligned to two 4KiB pages. */
+.syntax unified
+.arm
+.section .text.sunxi_header_entry,"ax",%progbits
+.global tee_spare_head
+.type tee_spare_head,%object
+tee_spare_head:
+    b tee_spare_head + 4092
+.size tee_spare_head, .-tee_spare_head
+.section .note.GNU-stack,"",%progbits
--- /dev/null
+++ b/core/arch/arm/plat-sun8iw20p1/reset.S
@@ -0,0 +1,21 @@
+/* Recovered early ARM secure/non-secure access policy at stock 0x41b02178.
+ * NSACR admits non-secure VFP/SMP, ACTLR enables coherent SMP and SCTLR
+ * selects low vectors. These are instructions, not embedded opcode data. */
+#include <arm32_macros.S>
+#include <arm.h>
+#include <asm.S>
+.arm
+FUNC plat_cpu_reset_early , :
+    mrc p15, 0, r1, c1, c1, 2
+    orr r1, r1, #NSACR_CP10
+    orr r1, r1, #NSACR_CP11
+    orr r1, r1, #NSACR_NS_SMP
+    mcr p15, 0, r1, c1, c1, 2
+    read_actlr r0
+    orr r0, r0, #ACTLR_SMP
+    write_actlr r0
+    read_sctlr r0
+    bic r0, r0, #SCTLR_V
+    write_sctlr r0
+    bx lr
+END_FUNC plat_cpu_reset_early
