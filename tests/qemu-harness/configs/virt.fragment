# ReForge QEMU virt test kernel config fragment
# Applied on top of multi_v7_defconfig via scripts/config --enable/--disable
#
# KEY FIX: ARCH_SUNXI=n
#   The vendor Tina BSP clk-mod0.c / clk-factors infrastructure is incompatible
#   with the legacy sun4i/sun9i clock drivers compiled by ARCH_SUNXI.
#   A qemu -M virt kernel needs ZERO sunxi drivers, so we disable ARCH_SUNXI
#   and all derived sunxi clock config symbols.
#
# FB pinning: CONFIG_FB_SIMPLE + -device ramfb,xres=800,yres=480,format=xrgb8888
#   ramfb is a QEMU firmware-level framebuffer that exposes /dev/fb0 at a fixed
#   resolution (800x480, xRGB8888=32bpp) via the DT simple-framebuffer binding.
#   No virtio-gpu negotiation or display backend needed for the headless test.

# --- DISABLE: Allwinner/sunxi drivers (broken in vendor BSP for virt) ---
# CONFIG_ARCH_SUNXI is not set
# CONFIG_CLK_SUNXI is not set
# CONFIG_CLK_SUNXI_CLOCKS is not set
# CONFIG_CLK_SUNXI_DDR is not set
# CONFIG_CLK_SUNXI_PRCM_SUN6I is not set
# CONFIG_CLK_SUNXI_PRCM_SUN8I is not set
# CONFIG_CLK_SUNXI_PRCM_SUN9I is not set
# CONFIG_SUNXI_CCU is not set
# CONFIG_COMMON_CLK_SUNXI is not set

# --- ENABLE: virt platform ---
CONFIG_ARCH_VIRT=y

# --- ENABLE: VirtIO transport + devices ---
CONFIG_VIRTIO=y
CONFIG_VIRTIO_PCI=y
CONFIG_VIRTIO_MMIO=y
CONFIG_VIRTIO_BLK=y
CONFIG_VIRTIO_NET=y
CONFIG_VIRTIO_CONSOLE=y
CONFIG_VIRTIO_INPUT=y

# --- ENABLE: DRM + virtio-gpu ---
CONFIG_DRM=y
CONFIG_DRM_KMS_HELPER=y
CONFIG_DRM_TTM=y
CONFIG_DRM_VIRTIO_GPU=y

# --- ENABLE: framebuffer (FB_SIMPLE for ramfb/simple-framebuffer) ---
CONFIG_FB=y
CONFIG_FB_SIMPLE=y
CONFIG_FRAMEBUFFER_CONSOLE=y

# --- ENABLE: zram compressed swap, BUILTIN ---
#   The device ships zram as loadable .ko built against the STOCK kernel
#   (vermagic "5.4.61 SMP preempt ..."). This virt kernel is built WITHOUT
#   PREEMPT, so those .ko can't load here (vermagic mismatch) and qemu mem
#   measurements miss zram. Build zram in so /dev/zram0 exists at boot:
#   S35zram's insmod fails gracefully, then it uses the builtin device (reset,
#   comp_algorithm=zstd, disksize, mkswap, swapon). CRYPTO_ZSTD = the algo.
CONFIG_SWAP=y
CONFIG_ZSMALLOC=y
CONFIG_ZRAM=y
CONFIG_CRYPTO_ZSTD=y

# --- ENABLE: filesystems + initramfs ---
CONFIG_EXT4_FS=y
CONFIG_BLK_DEV_INITRD=y

# --- ENABLE: eMMC + USB mass storage via PCI (production-look-alike) ---
#   On the AD5M, /data is at /dev/mmcblk0p7 and the USB stick is /dev/sda1.
#   To match those device names in qemu, we attach an emmc behind sdhci-pci
#   (needs MMC_SDHCI_PCI) and a USB stick behind qemu-xhci -> usb-storage
#   (needs USB_XHCI_PCI + USB_STORAGE + BLK_DEV_SD, all already enabled by
#   multi_v7_defconfig). The eMMC bit is the gap multi_v7 leaves: it has
#   platform SDHCI but not PCI SDHCI. Enabling it here gives /dev/mmcblk0.
CONFIG_MMC_SDHCI_PCI=y

# --- SPIKE: OverlayFS for the atomic-update / true-Mode-1 evaluation ---
#   Stock kernel has 'CONFIG_OVERLAY_FS is not set'. This fragment proves
#   the BSP fs/overlayfs/ source compiles + loads + mounts cleanly under
#   the same Buildroot toolchain we use for production, so we can decide
#   whether the overlay-based atomic update model from docs/BACKLOG.md is
#   reachable on the stock 5.4.61 BSP. Built =y for the spike (avoids
#   needing to ship a .ko + modprobe into the qemu guest); Kconfig is
#   tristate so =m is reachable by changing this one symbol.
#   See docs/research/2026-06-05-overlayfs-on-bsp-spike.md for results.
CONFIG_OVERLAY_FS=y
CONFIG_OVERLAY_FS_INDEX=y
CONFIG_OVERLAY_FS_XINO_AUTO=y

# --- ENABLE: device management ---
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y

# --- ENABLE: PL011 UART serial console (qemu -M virt) ---
CONFIG_SERIAL_AMBA_PL011=y
CONFIG_SERIAL_AMBA_PL011_CONSOLE=y
