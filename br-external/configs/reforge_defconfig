BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_VFPV4=y
# glibc pinned EXPLICITLY (not relying on the Buildroot default toolchain) so a
# future Buildroot bump cannot silently switch libc — reproducibility (spec §3/§4).
# Note: `make savedefconfig` will strip this as redundant-vs-default; do not run it
# against this file, or re-add this line afterward.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# Kernel headers pinned to EXACTLY match the stock kernel the rootfs runs on in
# P1-P3 (stock 5.4.61). glibc bakes in a min-kernel ELF note at build time; if
# userspace is built against newer headers than the runtime kernel, the dynamic
# loader aborts "FATAL: kernel too old" ON THE DEVICE (qemu-user hides this).
# The BR2_KERNEL_HEADERS_5_4 menu choice aged out of Buildroot 2026.02, so we pin
# a custom version. Bumps to the 6.x LTS when P4 ships our own mainline kernel.
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="5.4.61"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_5_4=y
BR2_REPRODUCIBLE=y
BR2_TARGET_GENERIC_HOSTNAME="reforge"
BR2_TARGET_GENERIC_ISSUE="Welcome to ReForge"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_REFORGE_PATH)/board/reforge/rootfs-overlay"
# Enable the busybox httpd applet (serves the Mainsail SPA; replaces nginx)
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_REFORGE_PATH)/board/reforge/busybox-fragment.config"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_REFORGE_PATH)/board/reforge/post-build.sh"
BR2_TARGET_ROOTFS_TAR_XZ=y
# Userspace-only — intentionally NO kernel, NO bootloader (P1-P3 ride the stock
# 5.4.61 kernel). BR2_LINUX_KERNEL and BR2_TARGET_UBOOT added in Plan 5.

# ---------------------------------------------------------------------------
# ReForge application stack (single image; SCREEN_MODE gates the on-screen GUI
# at runtime, so there is ONE defconfig — headless and on-screen share it).
# ---------------------------------------------------------------------------
# Single shared interpreter for klippy + moonraker (COW page sharing)
BR2_PACKAGE_PYTHON3=y
# Core Python stdlib modules required by klippy (zlib used by msgproto.py/json)
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_SQLITE=y
# Klipper host deps
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_PYTHON_CFFI=y
BR2_PACKAGE_PYTHON_SERIAL=y
BR2_PACKAGE_PYTHON_GREENLET=y
BR2_PACKAGE_PYTHON_JINJA2=y
BR2_PACKAGE_PYTHON_MARKUPSAFE=y
# Fortran needed to build numpy from source
BR2_TOOLCHAIN_BUILDROOT_FORTRAN=y
# Klipper host (klippy) + pre-compiled NEON chelper
BR2_PACKAGE_KLIPPER=y
# Moonraker API server (system python3, no venv, trimmed deps). Serves its own
# HTTP + WebSocket on :7125 — no reverse proxy needed.
BR2_PACKAGE_MOONRAKER=y
# Mainsail web UI (prebuilt static SPA bundle). Served by busybox httpd on :80;
# the browser talks to Moonraker directly at :7125 (cors_domains in moonraker.conf).
BR2_PACKAGE_MAINSAIL=y
# GuppyScreen — native LVGL touchscreen UI (framebuffer, talks to Moonraker).
# Launched only when SCREEN_MODE=GUPPY (S75guppyscreen); idle otherwise.
BR2_PACKAGE_GUPPYSCREEN=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_WPA_SUPPLICANT=y
# zram compressed swap — prebuilt modules for stock 5.4.61 kernel (P1-P3)
BR2_PACKAGE_REFORGE_ZRAM=y
