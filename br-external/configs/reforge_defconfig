BR2_arm=y
BR2_cortex_a7=y
BR2_ARM_FPU_VFPV4=y
# Size-optimized userspace: Thumb-2 (~25-30% smaller code) + -Os + locale purge.
# Measured -8% Pss (-4.9 MB) / -1 MB rootfs vs -O2/ARM, no runtime downside
# (docs/research/2026-06-01-memory-savings-experiments.md). NEON chelper still
# builds with -mcpu=cortex-a7; klippy/busybox/python verified running Thumb-2.
BR2_ARM_INSTRUCTIONS_THUMB2=y
BR2_OPTIMIZE_S=y
# Link-time optimization across all packages that support it: cross-TU dead-code
# elimination + inlining shrinks .text further on top of -Os/Thumb-2. libpython and
# the other .so are COW-shared, so the Pss win is modest but free; main payoff is
# smaller code pages + rootfs. Packages that can't LTO opt out individually.
BR2_ENABLE_LTO=y
BR2_ENABLE_LOCALE_PURGE=y
BR2_GENERATE_LOCALE="C"
# glibc pinned EXPLICITLY (not relying on the Buildroot default toolchain) so a
# future Buildroot bump cannot silently switch libc — reproducibility (spec §3/§4).
# Note: `make savedefconfig` will strip this as redundant-vs-default; do not run it
# against this file, or re-add this line afterward.
BR2_TOOLCHAIN_BUILDROOT_GLIBC=y
BR2_TOOLCHAIN_BUILDROOT_CXX=y
# gcc 15.2 (up from BR LTS default gcc 14.3). Measured -17.0% sum(Pss) across
# the stack at -m 128 -smp 2 cortex-a7 under qemu virt (no swap), driven by
# 25-50% size reductions in libpython3.14 / numpy / libcrypto / libc / libsqlite.
# Loop: autoresearch.md (2026-06-04). Per-iter data: autoresearch.jsonl.
BR2_GCC_VERSION_15_X=y
# Kernel headers pinned to EXACTLY match the stock kernel the rootfs runs on in
# P1-P3 (stock 5.4.61). glibc bakes in a min-kernel ELF note at build time; if
# userspace is built against newer headers than the runtime kernel, the dynamic
# loader aborts "FATAL: kernel too old" ON THE DEVICE (qemu-user hides this).
# The BR2_KERNEL_HEADERS_5_4 menu choice aged out of Buildroot 2026.02, so we pin
# a custom version. Bumps to the 6.x LTS when P4 ships our own mainline kernel.
BR2_KERNEL_HEADERS_VERSION=y
BR2_DEFAULT_KERNEL_VERSION="5.4.61"
BR2_PACKAGE_HOST_LINUX_HEADERS_CUSTOM_5_4=y
BR2_REPRODUCIBLE=y
BR2_TARGET_GENERIC_HOSTNAME="reforge"
BR2_TARGET_GENERIC_ISSUE="Welcome to ReForge"
BR2_SYSTEM_DHCP="eth0"
BR2_ROOTFS_OVERLAY="$(BR2_EXTERNAL_REFORGE_PATH)/board/reforge/rootfs-overlay"
# Enable the busybox httpd applet (serves the Mainsail SPA; replaces nginx)
BR2_PACKAGE_BUSYBOX_CONFIG_FRAGMENT_FILES="$(BR2_EXTERNAL_REFORGE_PATH)/board/reforge/busybox-fragment.config"
BR2_ROOTFS_POST_BUILD_SCRIPT="$(BR2_EXTERNAL_REFORGE_PATH)/board/reforge/post-build.sh"
BR2_TARGET_ROOTFS_TAR_XZ=y

# ---------------------------------------------------------------------------
# Linux kernel — our in-tree Tina BSP 5.4.61, built by Buildroot with its NATIVE
# toolchain (glibc + gcc 15.x). Source comes from vendor/kernels/tina-bsp-kernel
# via the package OVERRIDE_SRCDIR (br-external/local.mk), NOT a download. Config
# = the captured stock .config (board/reforge/linux.config).
#
# ADDITIVE: the standalone scripts stay the canonical references —
# build-bsp-kernel-stock.sh = byte-identical stock (Linaro GCC 5.3.1, the
# toolchain FlashForge actually shipped), build-bsp-kernel.sh = clean gcc 9.5
# rebuild, build-test-kernel.sh = the qemu-virt test kernel, modules/*/build.sh =
# the kmods. Buildroot's gcc-15 build is the integrated path and may need patches
# under linux/ (5.4.61 vs gcc 15). The recovered device DTS supplies board.dtb.
# No BR2_TARGET_UBOOT: the rootfs installation keeps the existing bootloader.
# ---------------------------------------------------------------------------
BR2_LINUX_KERNEL=y
BR2_LINUX_KERNEL_CUSTOM_VERSION=y
BR2_LINUX_KERNEL_CUSTOM_VERSION_VALUE="5.4.61"
BR2_LINUX_KERNEL_USE_CUSTOM_CONFIG=y
# $(REFORGE_LINUX_CONFIG) (local.mk) = linux.config (device, default) or
# linux-virt.config (qemu -M virt test kernel) when REFORGE_KERNEL=virt.
BR2_LINUX_KERNEL_CUSTOM_CONFIG_FILE="$(BR2_EXTERNAL_REFORGE_PATH)/board/reforge/$(REFORGE_LINUX_CONFIG)"
BR2_LINUX_KERNEL_ZIMAGE=y
# The BSP hardcodes `dtb-$(CONFIG_ARCH_SUN8IW20) += board.dtb`; the `all` target
# builds it. Device builds use the recovered stock DTS through board.dts; virt
# builds use an unused placeholder because QEMU supplies its hardware tree. Both
# source basenames stay board.dts so the BSP target builds and installs board.dtb.
BR2_LINUX_KERNEL_DTS_SUPPORT=y
BR2_LINUX_KERNEL_CUSTOM_DTS_PATH="$(BR2_EXTERNAL_REFORGE_PATH)/board/reforge/$(REFORGE_LINUX_DTS)"
BR2_PACKAGE_OVERRIDE_FILE="$(BR2_EXTERNAL_REFORGE_PATH)/local.mk"

# Camera: ustreamer (pikvm) — lightweight MJPEG-HTTP streamer for the USB-UVC cam,
# served on :8080 by S72camera (paths /stream + /snapshot). The cam is MJPG-native
# so it's pure passthrough (no re-encode). Pulls jpeg (→ libjpeg-turbo, NEON SIMD,
# already selected) + libevent + libbsd; host-pkgconf is build-only.
BR2_PACKAGE_USTREAMER=y

# ---------------------------------------------------------------------------
# ReForge application stack (single image; SCREEN_MODE gates the on-screen GUI
# at runtime, so there is ONE defconfig — headless and on-screen share it).
# ---------------------------------------------------------------------------
# Single shared interpreter for klippy + moonraker (COW page sharing)
BR2_PACKAGE_PYTHON3=y
# Ship the .py stdlib (source + .pyc). The Buildroot default PYC_ONLY produces a
# stdlib-LESS python with python 3.14.x (the .pyc step yields nothing), so
# /usr/bin/python3 can't import `encodings` and klippy/moonraker fail to start
# ("LookupError: no codec search functions registered"). PY_PYC keeps the source
# so the interpreter is functional regardless of the pyc bug.
BR2_PACKAGE_PYTHON3_PY_PYC=y
# Core Python stdlib modules required by klippy (zlib used by msgproto.py/json)
BR2_PACKAGE_PYTHON3_ZLIB=y
BR2_PACKAGE_PYTHON3_SSL=y
BR2_PACKAGE_PYTHON3_SQLITE=y
# Klipper host deps
BR2_PACKAGE_PYTHON_NUMPY=y
BR2_PACKAGE_PYTHON_CFFI=y
BR2_PACKAGE_PYTHON_SERIAL=y
BR2_PACKAGE_PYTHON_GREENLET=y
BR2_PACKAGE_PYTHON_JINJA2=y
BR2_PACKAGE_PYTHON_MARKUPSAFE=y
# dinit — service supervisor / init (binaries only; not wired as init yet,
# building block for a future switch_root PID 1)
BR2_PACKAGE_DINIT=y
# Klipper host (klippy) + pre-compiled NEON chelper
BR2_PACKAGE_KLIPPER=y
# Moonraker API server (system python3, no venv, trimmed deps). Serves its own
# HTTP + WebSocket on :7125 — no reverse proxy needed.
BR2_PACKAGE_MOONRAKER=y
# Mainsail web UI (prebuilt static SPA bundle). Served by busybox httpd on :80;
# the browser talks to Moonraker directly at :7125 (cors_domains in moonraker.conf).
BR2_PACKAGE_MAINSAIL=y
# GuppyScreen — native LVGL touchscreen UI (framebuffer, talks to Moonraker).
# Launched only when SCREEN_MODE=GUPPY (S75guppyscreen); idle otherwise.
BR2_PACKAGE_GUPPYSCREEN=y
BR2_PACKAGE_LIBEVDEV=y
BR2_PACKAGE_WPA_SUPPLICANT=y
# iwd: shipped alongside wpa_supplicant for the Mode 3 experiment. We do NOT
# switch the default daemon (net-up.sh still launches wpa_supplicant -Dnl80211);
# iwd's `iwctl` is on the rootfs so we can A/B against the rtl8821cu USB driver
# on real hardware before committing. Plan: if iwd associates cleanly on the
# AD5M's vendor-staging 8821cu, switch the Mode 3 default to iwd; otherwise
# park iwd at "available but unused" and rely on wpa_supplicant for both modes.
# See docs/BACKLOG.md "Mode 3 net stack: switch to iwd, skip ConnMan".
# Cost: ~620 KB iwd daemon + ~300 KB ell + ~150 KB iwctl + ~200 KB readline
# (pulled in by iwctl) + ~80 KB iwmon. Total ~1.4 MB.
BR2_PACKAGE_IWD=y
BR2_PACKAGE_IWD_IWMON=y
# Pulled in to enable iwd's `iwctl` interactive client (BR's iwd.mk conditions
# --enable-client on readline being present in the build).
BR2_PACKAGE_READLINE=y
# zram compressed swap — prebuilt modules for stock 5.4.61 kernel (P1-P3)
BR2_PACKAGE_JEMALLOC=y
# tuned for low RSS via MALLOC_CONF in the init scripts (-6.5MB measured)
BR2_PACKAGE_REFORGE_ZRAM=y
