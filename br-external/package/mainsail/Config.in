config BR2_PACKAGE_MAINSAIL
	bool "mainsail"
	select BR2_PACKAGE_NGINX
	help
	  Mainsail is the popular web interface for managing and
	  controlling 3D printers with Klipper firmware. It is a
	  prebuilt static web bundle served by nginx, which also
	  reverse-proxies the Moonraker API on port 7125.

	  https://github.com/mainsail-crew/mainsail
