#!/bin/sh
# ReForge boot/login banner — fire/ember art, sized to the 800x480 framebuffer
# console (8x16 font = 100x30 chars). Uses block/shade/box-drawing glyphs present
# in the kernel VGA/CP437 console font (█ ▓ ▒ ░ ▟ ▙ ▛ ▜ ▄ ▀ ═ ║ ╔ ╗ ╚ ╝), so it
# renders on the real panel; degrades to plain text on a dumb terminal. Fire
# gradient yellow(226) -> red(196). LIVE mode adds a run-from-USB badge.
# All elements are centred on a common axis; keep that when editing.

if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
    c() { printf '\033[1;38;5;%sm%s\033[0m\n' "$1" "$2"; }   # bold colored line
    d() { printf '\033[38;5;%sm%s\033[0m\n'   "$1" "$2"; }   # dim colored line
else
    c() { printf '%s\n' "$2"; }
    d() { printf '%s\n' "$2"; }
fi

printf '\n'
# Flame tongues in shaded blocks, cooling top to bottom.
d 226 '              ░▒▓    ▓▒░     ▒▓░'
c 220 '            ░▒▓█▓▒ ░▓██▓▒░  ▒▓█▓▒'
c 208 '          ▒▓██████▓▒████████▒██████▓▒'
printf '\n'
# REFORGE — solid block letters (R E F O R G E), vertical fire gradient.
c 226 '         ███ ███ ███ ███ ███ ███ ███'
c 220 '         █ █ █   █   █ █ █ █ █   █  '
c 214 '         ███ ██  ██  █ █ ███ █▄█ ██ '
c 208 '         █ █ █   █   █ █ █ █ █ █ █  '
c 202 '         █ █ ███ █   ███ █ █ ███ ███'
c 208 '         ▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀▀'
printf '\n'
# Steel anvil over the forge base.
d 250 '                 ▗▄████████▄▖'
c 248 '              ▟███████████████▙'
c 246 '              ▜███████████████▛'
d 245 '                 ▝▀████████▀▘'
d 243 '                    ██   ██'
c 202 '                ▟███████████▙'
printf '\n'
c 214 '            ReForge  —  Klipper, reforged'

# Version, if recorded by the build.
if [ -r /etc/reforge-version ]; then
    d 245 "            $(cat /etc/reforge-version 2>/dev/null)"
elif [ -r /etc/os-release ]; then
    _v="$(. /etc/os-release 2>/dev/null; echo "${VERSION:-}")"
    [ -n "${_v}" ] && d 245 "            ${_v}"
fi

# LIVE badge — run-from-USB, nothing written to eMMC. Triggered by REFORGE_LIVE
# (set by the live launcher) or a marker file. Interior is a fixed 40 columns so
# the double-box frame stays aligned.
if [ "${REFORGE_LIVE:-0}" = "1" ] || [ -e /run/reforge-live ] || [ -e /tmp/.reforge-live ]; then
    printf '\n'
    c 51 '       ╔════════════════════════════════════════╗'
    c 51 '       ║   LIVE  —  running from USB            ║'
    c 45 '       ║   eMMC untouched, pull+reboot = stock  ║'
    c 51 '       ╚════════════════════════════════════════╝'
fi
