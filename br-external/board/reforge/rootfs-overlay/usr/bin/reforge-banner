#!/bin/sh
# ReForge boot/login banner — fire/ember ASCII art.
# Fire gradient (top->bottom): bright yellow -> orange -> red.  Anvil in steel
# grays with an ember-hot base (the forge). 256-color ANSI; degrades to plain
# text on dumb terminals.

# Only colorize on a capable TTY.
if [ -t 1 ] && [ "${TERM:-dumb}" != "dumb" ]; then
    fire() { printf '\033[1;38;5;%sm%s\033[0m\n' "$1" "$2"; }
else
    fire() { printf '%s\n' "$2"; }
fi

printf '\n'
# REFORGE — vertical fire gradient (226 yellow -> 196 red)
fire 226 '   ____  _____ _____ ___  ____   ____ _____'
fire 220 '  |  _ \| ____|  ___/ _ \|  _ \ / ___| ____|'
fire 214 '  | |_) |  _| | |_ | | | | |_) | |  _|  _|'
fire 208 '  |  _ <| |___|  _|| |_| |  _ <| |_| | |___'
fire 202 '  |_| \_\_____|_|   \___/|_| \_\\____|_____|'
printf '\n'
# Anvil — steel grays, ember-hot base
fire 246 '              ___________'
fire 246 '         ____/           \____'
fire 245 '        /                     \___'
fire 244 '       |                          |'
fire 244 '       |__________________________|'
fire 243 '        \________________________/'
fire 242 '              ||          ||'
fire 240 '              ||__________||'
fire 196 '             /______________\'
printf '\n'
fire 208 '        ReForge  —  Klipper, reforged'
printf '\n'
