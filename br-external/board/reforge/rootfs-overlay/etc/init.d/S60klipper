#!/bin/sh
#
# S60klipper — start/stop Klipper (klippy)
#
# Uses the system python3 at /usr/bin/python3.
# jemalloc (LD_PRELOAD) tuned narenas:1,decay:0 — -6.5MB RSS vs glibc (§10b).
# The klippy unix socket is placed at /tmp/klippy_uds to match moonraker.conf.
# klippy will not fully initialise until /dev/ttyS5 (MCU) is present; that is
# an on-device (P3) concern — the script itself is correct.
#

DAEMON=/usr/bin/python3
DAEMON_ARGS="/opt/klipper/klippy/klippy.py /etc/reforge/printer.cfg \
    -a /tmp/klippy_uds \
    -l /var/log/klippy.log"
PIDFILE=/run/klipper.pid
NAME=klipper

case "$1" in
	start)
		echo "Starting $NAME..."
		export LD_PRELOAD=/usr/lib/libjemalloc.so.2
		export MALLOC_CONF=narenas:1,dirty_decay_ms:0,muzzy_decay_ms:0
		mkdir -p /var/log /run
		start-stop-daemon -S -b -m -p "$PIDFILE" \
			-x "$DAEMON" -- $DAEMON_ARGS
		;;
	stop)
		echo "Stopping $NAME..."
		start-stop-daemon -K -p "$PIDFILE" -x "$DAEMON" -o
		rm -f "$PIDFILE"
		;;
	restart)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
