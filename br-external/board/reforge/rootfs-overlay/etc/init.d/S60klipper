#!/bin/sh
#
# S60klipper — start/stop Klipper (klippy)
#
# Uses the system python3 at /usr/bin/python3.
#
# NOTE: klippy runs WITHOUT jemalloc, unlike moonraker (S65). On real hardware
# jemalloc's LD_PRELOAD corrupts klippy's heap — it aborts with
# "free(): invalid size" (SIGABRT) seconds after reaching ready, right as the
# heater-check timer fires. The trigger is klippy's NEON/thumb2 C helper
# (klippy/chelper/c_helper.so) interacting with jemalloc's interposed
# malloc/free; glibc's allocator runs it cleanly. The earlier "-6.5MB RSS"
# jemalloc win was measured under qemu (no real chelper path), which never hit
# the abort. moonraker has no C helper and is unaffected, so it keeps jemalloc.
# The klippy unix socket is placed at /tmp/klippy_uds to match moonraker.conf.
#

DAEMON=/usr/bin/python3
DAEMON_ARGS="/opt/klipper/klippy/klippy.py /etc/reforge/printer.cfg \
    -a /tmp/klippy_uds \
    -l /var/log/klippy.log"
PIDFILE=/run/klipper.pid
NAME=klipper

case "$1" in
	start)
		echo "Starting $NAME..."
		# NO jemalloc here — see header. glibc malloc keeps klippy stable.
		mkdir -p /var/log /run
		start-stop-daemon -S -b -m -p "$PIDFILE" \
			-x "$DAEMON" -- $DAEMON_ARGS
		;;
	stop)
		echo "Stopping $NAME..."
		start-stop-daemon -K -p "$PIDFILE" -x "$DAEMON" -o
		rm -f "$PIDFILE"
		;;
	restart)
		"$0" stop
		"$0" start
		;;
	*)
		echo "Usage: $0 {start|stop|restart}"
		exit 1
		;;
esac
