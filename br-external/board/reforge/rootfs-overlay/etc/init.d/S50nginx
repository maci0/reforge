#!/bin/sh
#
# S50nginx — stub: nginx is managed by S70nginx (ReForge overlay).
# This file overrides the package-installed S50nginx to prevent a
# double-start; actual start/stop is handled later at S70.
#
case "$1" in
	start|stop|restart|reload|force-reload) ;;
	*) echo "Usage: $0 {start|stop|restart|reload|force-reload}"; exit 1 ;;
esac
