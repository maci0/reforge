#!/bin/sh
# ReForge boot hook — installed at /etc/init.d/S01reforge
# Called by the stock /etc/rcS with argument "start".
#
# POSIX sh / BusyBox compatible.
#
# Design mirrors forge-x's S00init + S99root pattern:
#   - SKIP_MOD guard   → exit 0 (pure stock boot)
#   - bind-mount the ReForge rootfs at /reforge (a real mountpoint)
#   - bind-mount proc/sys/dev into /reforge
#   - chroot into /reforge and exec the init chain
#     (later this becomes a switch_root into /reforge; see sbin/reforge-init)
#
# REFORGE_DATA_ROOT env override (default /data) lets Task 3 loopback
# tests point DATA at a scratch directory without modifying this script.

set -e

DATA="${REFORGE_DATA_ROOT:-/data}"
REFORGE_DIR="${DATA}/.mod/.reforge"
CONF="${REFORGE_DIR}/config/screen.conf"

# ---------------------------------------------------------------------------
# SKIP_MOD dual-boot guard (mirrors forge-x S99root:11-15)
# Presence of any of these markers means: skip ReForge, boot stock.
#   /tmp/SKIP_MOD              — set by forge-x or user tool (USB flag)
#   $DATA/.reforge/SKIP_MOD    — persistent per-boot skip flag on /data
# ---------------------------------------------------------------------------
if [ -f /tmp/SKIP_MOD ] || \
   [ -f /tmp/SKIP_MOD_SOFT ] || \
   [ -f /tmp/SKIP_MOD_HARD ] || \
   [ -f "${REFORGE_DIR}/SKIP_MOD" ]; then
    echo "[reforge-boot] SKIP_MOD active — booting stock firmware"
    exit 0
fi

# ---------------------------------------------------------------------------
# Sanity: make sure the overlay is installed
# ---------------------------------------------------------------------------
if [ ! -d "${REFORGE_DIR}" ]; then
    echo "[reforge-boot] WARN: ${REFORGE_DIR} not found — skipping ReForge boot"
    exit 0
fi

if [ ! -f "${REFORGE_DIR}/.installed" ]; then
    echo "[reforge-boot] WARN: .installed stamp missing — skipping ReForge boot"
    exit 0
fi

# ---------------------------------------------------------------------------
# Fire/ember boot banner (the script lives in the ReForge rootfs; it is plain
# sh+awk, so we can render it from the stock side before the chroot).
# ---------------------------------------------------------------------------
if [ -f "${REFORGE_DIR}/usr/bin/reforge-banner" ]; then
    TERM=linux sh "${REFORGE_DIR}/usr/bin/reforge-banner" --animate 2>/dev/null || true
fi

# ---------------------------------------------------------------------------
# Read persisted screen mode
# ---------------------------------------------------------------------------
SCREEN_MODE="HEADLESS"
if [ -f "${CONF}" ]; then
    # Source only the SCREEN_MODE line — safer than a full source
    _sm="$(grep '^SCREEN_MODE=' "${CONF}" | head -n 1 | cut -d= -f2)"
    [ -n "${_sm}" ] && SCREEN_MODE="${_sm}"
fi
echo "[reforge-boot] screen mode: ${SCREEN_MODE}"

# ---------------------------------------------------------------------------
# SCREEN_MODE=STOCK — yield to stock firmwareExe via the SKIP_MOD escape hatch.
#
# Documented dual-boot value (architecture.md: "SCREEN_MODE ... STOCK = the stock
# firmwareExe, feasibility-confirmed"). We implement it by routing through the
# SKIP_MOD path: touch /tmp/SKIP_MOD so any later ReForge entry point in this
# boot also bails, log the choice, and exit 0 so the stock /etc/rcS continues
# past S01reforge and reaches the stock auto_run.sh / firmwareExe launch.
#
# Reversible: the marker is on tmpfs, so the *next* boot reads SCREEN_MODE
# again from $CONF. To make the stock choice persistent, write SCREEN_MODE=STOCK
# to ${CONF}; to clear it, write GUPPY or HEADLESS (or `rm ${CONF}`).
# ---------------------------------------------------------------------------
if [ "${SCREEN_MODE}" = "STOCK" ]; then
    echo "[reforge-boot] SCREEN_MODE=STOCK — touching /tmp/SKIP_MOD, booting stock firmware"
    : > /tmp/SKIP_MOD || true
    exit 0
fi

# ---------------------------------------------------------------------------
# Mount /data if not already mounted (mirrors forge-x common.sh:47-64)
# The stock auto_run.sh mounts mmcblk0p7 → /data before calling rcS, but
# we guard here in case we run in a test env without that.
# ---------------------------------------------------------------------------
if [ "${DATA}" = "/data" ] && ! mount | grep -q '/dev/mmcblk0p7'; then
    echo "[reforge-boot] /data not mounted — attempting mount"
    fsck -y /dev/mmcblk0p7 2>/dev/null || true
    mount /dev/mmcblk0p7 /data || {
        echo "[reforge-boot] ERROR: cannot mount /data — aborting"
        exit 1
    }
fi

# ---------------------------------------------------------------------------
# Mount the ReForge rootfs at /reforge.
#
# Up to here ${REFORGE_DIR} (=$DATA/.mod/.reforge) is just a directory on /data.
# We bind it onto a dedicated mountpoint /reforge so the rest of boot — the
# chroot mounts, the chroot itself, and (later) a switch_root — operate on a
# real mount rather than a path under /data. This is the ONLY thing that changes
# on the stock side: from here on the stock init only ever execs into /reforge.
#
# Today this is a plain bind of the installed rootfs. It is the seam where the
# immutable-reforge work later swaps in the OverlayFS merged view, and where a
# future switch_root pivots root to /reforge instead of chrooting.
# ---------------------------------------------------------------------------
# REFORGE_ROOT env override (default /reforge) mirrors REFORGE_DATA_ROOT: it lets
# a host-side test point the rootfs mountpoint at a scratch dir instead of the
# real /reforge.
REFORGE_ROOT="${REFORGE_ROOT:-/reforge}"
mkdir -p "${REFORGE_ROOT}"
if ! grep -q " ${REFORGE_ROOT} " /proc/mounts 2>/dev/null; then
    echo "[reforge-boot] mounting rootfs at ${REFORGE_ROOT} ..."
    mount --bind "${REFORGE_DIR}" "${REFORGE_ROOT}"
fi

# ---------------------------------------------------------------------------
# Set up chroot mounts via the shared helper (also used by the live launcher).
# tmp_mode=bind: share the stock /tmp so SKIP_MOD markers etc. stay consistent.
# ---------------------------------------------------------------------------
echo "[reforge-boot] mounting chroot filesystems ..."

HELPER="${REFORGE_ROOT}/.shell/reforge-chroot.sh"
[ -f "${HELPER}" ] || { echo "[reforge-boot] ERROR: ${HELPER} missing"; exit 1; }
# shellcheck source=/dev/null
. "${HELPER}"
reforge_chroot_mounts "${REFORGE_ROOT}" "${DATA}" bind

# NOTE: we deliberately do NOT bind the stock /opt/config. ReForge is fully
# self-contained: klippy uses /etc/reforge/printer.cfg and moonraker uses
# /etc/reforge/moonraker.conf (both inside the chroot, on /data/.mod/.reforge). The
# persistent changes ReForge makes to the stock rootfs are the single
# /etc/init.d/S01reforge symlink plus the empty /reforge mountpoint dir.
# Everything else lives in /data/.mod/.reforge or is a transient runtime
# bind-mount (the /reforge rootfs + proc/sys/dev/run/tmp/data) undone on reboot.

sync

# ---------------------------------------------------------------------------
# Boot the toolhead ("eboard") MCU — early, right after the chroot mounts, the
# same way the live launcher does. The eboard (/dev/ttyS1) powers up in a serial
# bootloader that waits for the host to send 'A' before starting its Klipper app;
# the mainboard MCU auto-boots and needs no trigger. Stock (firmwareExe
# "bootserial eboard:") and forge-x (its boot_mcu binary, run from boot.sh in any
# screen mode) both do this — ReForge must too, or klippy can never identify the
# eboard ("Serial connection closed") and the toolhead stays dark. Best-effort:
# on a warm reboot (eboard already in its app) the handshake just no-ops.
# ---------------------------------------------------------------------------
echo "[reforge-boot] booting eboard MCU (toolhead) ..."
chroot "${REFORGE_ROOT}" /usr/bin/reforge-boot-eboard \
    || echo "[reforge-boot] eboard boot handshake non-zero (already up?) — continuing"

# ---------------------------------------------------------------------------
# Trial / last-known-good (LKG) guard — runs on the STOCK side BEFORE we chroot
# into the mod dir, so a brick during the mod's own boot is still counted.
#
# reforge-lkg.sh resolves /data/.mod/.reforge/{mod,lkg,state} (via REFORGE_DATA_ROOT
# -> DATA), the SAME inodes that S99ok sees inside the chroot.  We source the mod
# copy.  The helpers may return non-zero (is_trial returns 1 on a non-trial /
# fresh boot), so guard each call under `set -e`.
#
# Flow:
#   - A SKIP_MOD marker already exited above => trial state is never touched.
#   - Not a trial (versions match, or lkg absent on a fresh device) => no-op.
#   - Trial + counter >= N (3 failed boots) => the new mod is bad: restore LKG.
#   - Trial + counter <  N => count this attempt BEFORE exec'ing the mod init.
# On a successful boot, S99ok promotes mod -> lkg and resets the counter.
# ---------------------------------------------------------------------------
LKG_HELPERS="${REFORGE_DIR}/mod/.shell/reforge-lkg.sh"
if [ -f "${LKG_HELPERS}" ]; then
    # export so the sourced script's DATA resolves to this DATA in test mode;
    # in production REFORGE_DATA_ROOT is unset and DATA defaults to /data.
    [ "${DATA}" = "/data" ] || export REFORGE_DATA_ROOT="${DATA}"
    # shellcheck source=/dev/null  # path resolved at runtime from the installed mod
    . "${LKG_HELPERS}"
    if is_trial; then
        _cnt="$(lkg_counter_get)"
        if [ "${_cnt}" -ge "${N}" ]; then
            echo "[reforge-boot] trial failed ${N}x (count=${_cnt}) — restoring LKG"
            lkg_restore
        else
            echo "[reforge-boot] trial boot (count=${_cnt}) — incrementing trial counter"
            lkg_counter_inc
        fi
    fi
fi

# ---------------------------------------------------------------------------
# Run the ReForge init chain IN PLACE from the self-contained mod dir.
#
# The reforge-authored init lives in the OTA-updatable /mod (chroot-internal):
#   /mod/start.sh runs /mod/init.d/S* in sorted order — no /etc/init.d mirror.
#   The S-scripts it calls:
#     S00cloudblock  S35zram  S60klipper  S65moonraker  S70httpd
#     S75guppyscreen (only when SCREEN_MODE=GUPPY)
# A zip update of /mod is therefore live on the next boot with no copy step.
# We exec /mod/start.sh and pass SCREEN_MODE so it can decide whether to
# launch GuppyScreen.
# ---------------------------------------------------------------------------
CHROOT_START="${REFORGE_DIR}/mod/start.sh"

if [ ! -x "${CHROOT_START}" ]; then
    # Fallback: exec a login shell (useful during development / qemu tests)
    echo "[reforge-boot] WARN: ${CHROOT_START} not executable — falling back to /bin/sh"
    exec chroot "${REFORGE_ROOT}" /bin/sh
fi

echo "[reforge-boot] launching ReForge via chroot (run-from-mod) ..."
export SCREEN_MODE
exec chroot "${REFORGE_ROOT}" /mod/start.sh
