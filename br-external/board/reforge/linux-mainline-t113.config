# Mainline board kernel for the AD5M (Pro): Allwinner T113 (sun8i), applied as
# KCONFIG_ALLCONFIG on top of `allnoconfig` by tools/build/build-mainline-kernel.sh.
# Everything not listed here is off. The build fails if any line below does not
# survive into the final .config.
#
# Scope: the peripherals the printer uses (docs/board-notes/device-overview.md)
# and the kernel features the ReForge rootfs uses. Size proxy only: no board DTS
# yet, not booted (docs/research/kernel/2026-10-27-mainline-board-kernel.md).

# --- platform ---------------------------------------------------------------
CONFIG_MMU=y
CONFIG_ARCH_MULTI_V7=y
CONFIG_ARCH_SUNXI=y
CONFIG_MACH_SUN8I=y
CONFIG_SMP=y
CONFIG_NR_CPUS=2
CONFIG_ARM_PSCI=y
CONFIG_VFP=y
CONFIG_NEON=y
CONFIG_AEABI=y
CONFIG_USE_OF=y
CONFIG_ATAGS=n
CONFIG_SUSPEND=n

# --- size knobs (same set as the stocklike study) ---------------------------
CONFIG_EXPERT=y
CONFIG_CC_OPTIMIZE_FOR_SIZE=y
CONFIG_LD_DEAD_CODE_DATA_ELIMINATION=y
CONFIG_MODULES=n

# --- core kernel features gated by EXPERT ------------------------------------
CONFIG_MULTIUSER=y
CONFIG_SYSFS_SYSCALL=y
CONFIG_FHANDLE=y
CONFIG_POSIX_TIMERS=y
CONFIG_PRINTK=y
CONFIG_BUG=y
CONFIG_BASE_SMALL=n
CONFIG_FUTEX=y
CONFIG_EPOLL=y
CONFIG_SIGNALFD=y
CONFIG_TIMERFD=y
CONFIG_EVENTFD=y
CONFIG_SHMEM=y
CONFIG_ADVISE_SYSCALLS=y
CONFIG_MEMBARRIER=y
CONFIG_RSEQ=y
CONFIG_SYSCTL=y
CONFIG_SYSVIPC=y
CONFIG_POSIX_MQUEUE=y
CONFIG_BINFMT_ELF=y
CONFIG_BINFMT_SCRIPT=y
CONFIG_TTY=y
CONFIG_UNIX98_PTYS=y
CONFIG_INPUT=y
CONFIG_INPUT_EVDEV=y

# --- SoC: clocks, pins, power, DMA, timers ------------------------------------
CONFIG_COMMON_CLK=y
CONFIG_SUNXI_CCU=y
CONFIG_SUN20I_D1_CCU=y
CONFIG_SUN20I_D1_R_CCU=y
CONFIG_SUN8I_DE2_CCU=y
CONFIG_PINCTRL_SUN20I_D1=y
CONFIG_PM=y
CONFIG_SUN20I_PPU=y
CONFIG_SUNXI_SRAM=y
CONFIG_REGULATOR=y
CONFIG_REGULATOR_FIXED_VOLTAGE=y
CONFIG_REGULATOR_SUN20I=y
CONFIG_DMADEVICES=y
CONFIG_DMA_SUN6I=y
CONFIG_NVMEM=y
CONFIG_NVMEM_SUNXI_SID=y
CONFIG_RTC_CLASS=y
CONFIG_RTC_DRV_SUN6I=y
CONFIG_WATCHDOG=y
CONFIG_SUNXI_WATCHDOG=y
CONFIG_THERMAL=y
CONFIG_SUN8I_THERMAL=y
CONFIG_GPIOLIB=y

# --- UARTs: console + both MCUs (ttyS1 eboard, ttyS5 mainboard) ---------------
CONFIG_SERIAL_8250=y
CONFIG_SERIAL_8250_CONSOLE=y
CONFIG_SERIAL_8250_DW=y
CONFIG_SERIAL_OF_PLATFORM=y
CONFIG_SERIAL_8250_NR_UARTS=6
CONFIG_SERIAL_8250_RUNTIME_UARTS=6

# --- eMMC -------------------------------------------------------------------
CONFIG_MMC=y
CONFIG_MMC_SUNXI=y
CONFIG_MMC_BLOCK=y
CONFIG_PARTITION_ADVANCED=y
CONFIG_EFI_PARTITION=y

# --- USB host: WiFi, UVC camera, USB stick, USB-ACM MCUs ---------------------
CONFIG_USB_SUPPORT=y
CONFIG_USB=y
CONFIG_USB_EHCI_HCD=y
CONFIG_USB_EHCI_HCD_PLATFORM=y
CONFIG_USB_OHCI_HCD=y
CONFIG_USB_OHCI_HCD_PLATFORM=y
CONFIG_EXTCON=y
CONFIG_POWER_SUPPLY=y
CONFIG_PHY_SUN4I_USB=y
CONFIG_USB_ACM=y
CONFIG_USB_STORAGE=y
CONFIG_SCSI=y
CONFIG_BLK_DEV_SD=y

# --- display: DE2 -> TCON LCD -> RGB panel, GPIO backlight, Goodix touch ------
CONFIG_DRM=y
CONFIG_DRM_SUN4I=y
CONFIG_DRM_SUN8I_MIXER=y
CONFIG_DRM_SUN8I_TCON_TOP=y
CONFIG_DRM_PANEL_SIMPLE=y
CONFIG_DRM_FBDEV_EMULATION=y
CONFIG_SPI=y
CONFIG_SPI_SUN6I=y
CONFIG_BACKLIGHT_CLASS_DEVICE=y
CONFIG_BACKLIGHT_GPIO=y
CONFIG_I2C=y
CONFIG_I2C_MV64XXX=y
CONFIG_INPUT_TOUCHSCREEN=y
CONFIG_TOUCHSCREEN_GOODIX=y

# --- camera: USB UVC, MJPEG (ustreamer) ------------------------------------------
CONFIG_MEDIA_SUPPORT=y
CONFIG_MEDIA_SUPPORT_FILTER=y
CONFIG_MEDIA_CAMERA_SUPPORT=y
CONFIG_MEDIA_USB_SUPPORT=y
CONFIG_USB_VIDEO_CLASS=y

# --- network: on-SoC EMAC (RMII), RTL8821CU WiFi, IPv4 -----------------------
CONFIG_NET=y
CONFIG_UNIX=y
CONFIG_PACKET=y
CONFIG_INET=y
CONFIG_IPV6=n
CONFIG_NETDEVICES=y
CONFIG_ETHERNET=y
CONFIG_NET_VENDOR_STMICRO=y
CONFIG_ETHTOOL_NETLINK=y
CONFIG_STMMAC_ETH=y
CONFIG_STMMAC_PLATFORM=y
CONFIG_DWMAC_SUN8I=y
CONFIG_WIRELESS=y
CONFIG_CFG80211=y
CONFIG_MAC80211=y
CONFIG_WLAN=y
CONFIG_WLAN_VENDOR_REALTEK=y
CONFIG_RTW88=y
CONFIG_RTW88_8821CU=y
CONFIG_FW_LOADER=y

# --- storage features the rootfs uses ----------------------------------------
CONFIG_BLOCK=y
CONFIG_EXT4_FS=y
CONFIG_VFAT_FS=y
CONFIG_NLS_CODEPAGE_437=y
CONFIG_NLS_ISO8859_1=y
CONFIG_PROC_FS=y
CONFIG_SYSFS=y
CONFIG_TMPFS=y
CONFIG_DEVTMPFS=y
CONFIG_DEVTMPFS_MOUNT=y
CONFIG_INOTIFY_USER=y
CONFIG_SWAP=y
CONFIG_BLK_DEV=y
CONFIG_ZRAM=y
CONFIG_ZRAM_BACKEND_ZSTD=y
