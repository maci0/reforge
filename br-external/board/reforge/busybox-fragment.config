# ReForge busybox config fragment (appended to the Buildroot busybox .config).
# Enables the httpd applet used to serve the Mainsail static SPA (S70httpd),
# replacing nginx. Range + gzip help Mainsail serve assets / webcam efficiently.
CONFIG_HTTPD=y
CONFIG_FEATURE_HTTPD_RANGES=y
CONFIG_FEATURE_HTTPD_GZIP=y
CONFIG_FEATURE_HTTPD_ETAG=y
