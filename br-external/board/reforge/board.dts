/dts-v1/;

/*
 * board.dts — placeholder to satisfy the Allwinner Tina BSP's hardcoded
 * `dtb-$(CONFIG_ARCH_SUN8IW20) += board.dtb` (arch/arm/boot/dts/Makefile:1138).
 *
 * The higher-level Longan/Lichee SDK normally injects a real board.dts here from
 * outside the kernel tree; we don't have that step, so Buildroot copies THIS file
 * in via BR2_LINUX_KERNEL_CUSTOM_DTS_PATH. It only needs to compile so the `all`
 * target (which builds dtbs) succeeds — the resulting board.dtb is throwaway.
 *
 * The device's REAL device tree is NOT bundled in the kernel: stock boot.img has
 * second_size=0 (no DTB slot), and U-Boot loads the dtb from boot-resource
 * (mmcblk0p1). The reverse-engineered device dtb (fw-analysis/k-3.1.3/sunxi.dtb,
 * dtc-decompiled) is that boot-resource artifact, handled separately.
 *
 * To make Buildroot emit a faithful device board.dtb instead, replace this file
 * with the decompiled sunxi.dts (dtc -I dtb -O dts fw-analysis/k-3.1.3/sunxi.dtb).
 */

/ {
	model = "ReForge AD5M/Pro (placeholder board.dtb)";
	compatible = "allwinner,sun8iw20p1", "allwinner,sun8iw20";
	#address-cells = <1>;
	#size-cells = <1>;

	chosen { };
};
