@@ -0,0 +1,361 @@
+/* Reconstructed T113 DRAM channel initialization and standby recovery.
+ * r1: dram_para_t * (r0 is the unused channel index).
+ * r4 holds DQS gating mode, r5 the PHY gate-control register, r6 parameters,
+ * and r7 the PHY status register. Later recovery reuses r6 for control MMIO.
+ * Return the vendor training result: 1 without training errors, 0 otherwise.
+ */
+.syntax unified
+.arch armv7-a
+.thumb
+.equ COM_TIMER,       0x0310200c
+.equ COM_CLOCK_CTRL,  0x03102014
+.equ PHY_PIR,         0x03103000
+.equ PHY_REG_004,     0x03103004
+.equ PHY_PGSR0,       0x03103010
+.equ PHY_STATUS,      0x03103018
+.equ PHY_DRAMTMG2,    0x03103060
+.equ PHY_REFRESH,     0x0310308c
+.equ PHY_DQS_DELAY,   0x031030bc
+.equ PHY_RANK_CTRL,   0x031030c0
+.equ PHY_GATE_CTRL,   0x03103108
+.equ PHY_REG_10C,     0x0310310c
+.equ PHY_DXCCR,       0x0310311c
+.equ PHY_ZQ_CTRL,     0x03103140
+.equ PHY_REG_208,     0x03103208
+.equ PHY_DX0_GCR0,    0x03103344
+.equ PHY_DX1_GCR0,    0x031033c4
+.equ RTC_STANDBY,     0x070005d4
+.equ SYSTEM_POWER,    0x07010250
+.equ SINGLE_RANK_CFG, 0x01003087
+.equ DRAM_CLK,   0
+.equ DRAM_TYPE,  4
+.equ DRAM_ZQ,    8
+.equ DRAM_ODT,   12
+.equ DRAM_PARA2, 20
+.equ DRAM_TPR13, 92
+.equ FAST_DRAM_CLK, 672
+
+.section .text.mctl_channel_init,"ax",%progbits
+.p2align 2
+.global mctl_channel_init
+.type mctl_channel_init, %function
+.thumb_func
+mctl_channel_init:
+	ldr r0, =COM_TIMER
+	push {r3, r4, r5, r6, r7, r8, r9, lr}
+	mov r6, r1
+	ldr r4, [r1, #DRAM_TPR13]
+	ldr r1, [r1, #DRAM_CLK]
+	ldr r2, [r0]
+	ubfx r4, r4, #2, #2
+	ldr r5, =PHY_GATE_CTRL
+	cmp r1, #FAST_DRAM_CLK
+	lsr.w r3, r1, #1
+	bic r2, r2, #0xff0
+	bic r2, r2, #0xf
+	add.w r3, r3, #-1
+	orr r3, r3, r2
+	ldr r2, [r6, #DRAM_ODT]
+	str r3, [r0]
+	/* Form DX0's address with encodable Thumb immediates. */
+	add.w r0, r0, #(PHY_DX0_GCR0-COM_TIMER-0x18)
+	ldr r3, [r5]
+	add.w r0, r0, #0x18
+	mvn.w r2, r2
+	lsl.w r2, r2, #5
+	bic r3, r3, #0xf00
+	orr r3, r3, #0x300
+	and r2, r2, #0x20
+	str r3, [r5]
+
+	/* Both data slices share ODT polarity and the fast-clock setting. */
+	ldr r3, [r0]
+	bic r3, r3, #0x30
+	orr r3, r3, r2
+	itete hi
+	bichi r3, r3, #0xf600
+	bicls r3, r3, #0xf000
+	bichi r3, r3, #0x1e
+	bicls r3, r3, #0x1e
+	it hi
+	orrhi r3, r3, #0x400
+	cmp r1, #FAST_DRAM_CLK
+	str r3, [r0]
+	ldr r0, =PHY_DX1_GCR0
+	ldr r3, [r0]
+	bic r3, r3, #0x30
+	orr r3, r3, r2
+	ldr r2, =PHY_REG_208
+	itete hi
+	bichi r3, r3, #0xf600
+	bicls r3, r3, #0xf000
+	bichi r3, r3, #0x1e
+	bicls r3, r3, #0x1e
+	it hi
+	orrhi r3, r3, #0x400
+	str r3, [r0]
+	mov r0, r6
+	ldr r3, [r2]
+	orr r3, r3, #2
+	str r3, [r2]
+	bl eye_delay_compensation
+
+	cmp r4, #1
+	beq .Lgate_mode_one
+	cmp r4, #2
+	beq.w .Lgate_mode_two
+	ldr r3, [r5]
+	movs r0, #10
+	bic r3, r3, #0x40
+	str r3, [r5]
+	bl __usdelay
+	ldr r3, [r5]
+	orr r3, r3, #0xc0
+	str r3, [r5]
+	b .Lgate_ready
+.Lgate_mode_one:
+	ldr r3, [r5]
+	ldr r2, =PHY_DQS_DELAY
+	bic r3, r3, #0xc0
+	str r3, [r5]
+	ldr r3, [r2]
+	bic r3, r3, #0x106
+	bic r3, r3, #1
+.Lwrite_gate_delay:
+	str r3, [r2]
+.Lgate_ready:
+	/* LPDDR2 and LPDDR3 need their corresponding DX control settings. */
+	ldr r3, [r6, #DRAM_TYPE]
+	subs r3, #6
+	cmp r3, #1
+	bhi .Lrank_control
+	ldr r2, =PHY_DXCCR
+	cmp r4, #1
+	ldr r3, [r2]
+	itete eq
+	biceq r3, r3, #0x08000000
+	bicne r3, r3, #0x77000000
+	biceq r3, r3, #0xc0
+	orrne r3, r3, #0x22000000
+	it eq
+	orreq r3, r3, #0x80000000
+	str r3, [r2]
+.Lrank_control:
+	ldr r3, [r6, #DRAM_PARA2]
+	ldr r2, =PHY_RANK_CTRL
+	tst r3, #0x1000
+	iteet ne
+	ldrne r3, [r2]
+	ldreq r1, [r2]
+	ldreq r3, =SINGLE_RANK_CFG
+	andne r3, r3, #0xf0000000
+	itete ne
+	orrne r3, r3, #0x03000000
+	andeq r1, r1, #0xf0000000
+	orrne r3, r3, #1
+	orreq r3, r1
+	str r3, [r2]
+	ldr r3, =RTC_STANDBY
+	ldr r3, [r3]
+	lsls r1, r3, #15
+	bpl .Lzq_configuration
+	ldr r2, =SYSTEM_POWER
+	movs r0, #10
+	ldr r3, [r2]
+	bic r3, r3, #2
+	str r3, [r2]
+	bl __usdelay
+.Lzq_configuration:
+	ldr r1, =PHY_ZQ_CTRL
+	cmp r4, #1
+	ldr r7, =PHY_PGSR0
+	ldr r3, [r1]
+	and r3, r3, #0xfc000000
+	orr r2, r3, #0x02000000
+	ldr r3, [r6, #DRAM_ZQ]
+	bic r3, r3, #0xff000000
+	orr r3, r3, r2
+	str r3, [r1]
+	bne.w .Lother_initialization
+
+	/* Mode 1 first initializes PHY reset, PLL, and ZQ calibration. */
+	ldr r3, =PHY_PIR
+	movs r2, #0x52
+	str r2, [r3]
+	movs r2, #0x53
+	str r2, [r3]
+.Lwait_first_idone:
+	ldr r3, [r7]
+	lsls r2, r3, #31
+	bpl .Lwait_first_idone
+	movs r0, #10
+	bl __usdelay
+	ldr r3, [r6, #DRAM_TYPE]
+	cmp r3, #3
+	ite ne
+	movne r3, #0x520
+	moveq r3, #0x5a0
+.Lstart_initialization:
+	ldr r2, =PHY_PIR
+	movs r0, #10
+	str r3, [r2]
+	orr r3, r3, #1
+	str r3, [r2]
+	bl __usdelay
+.Lwait_idone:
+	ldr r3, [r7]
+	lsls r0, r3, #31
+	bpl .Lwait_idone
+	ldr r3, =RTC_STANDBY
+	ldr r3, [r3]
+	lsls r1, r3, #15
+	bpl .Ltraining_result
+
+	/* Resume from standby, preserving the required MMIO/delay ordering. */
+	ldr r6, =PHY_REG_10C
+	movs r0, #10
+	ldr r3, [r6]
+	bic r3, r3, #0x06000000
+	orr r3, r3, #0x04000000
+	str r3, [r6]
+	bl __usdelay
+	ldr r3, =PHY_REG_004
+	ldr r2, [r3]
+	mov r8, r3
+	orr r2, r2, #1
+	str r2, [r3]
+	ldr r2, =PHY_STATUS
+	mov r9, r2
+.Lwait_self_refresh:
+	ldr r3, [r2]
+	and r3, r3, #7
+	cmp r3, #3
+	bne .Lwait_self_refresh
+	ldr r2, =SYSTEM_POWER
+	movs r0, #10
+	ldr r3, [r2]
+	bic r3, r3, #1
+	str r3, [r2]
+	bl __usdelay
+	ldr r3, [r8]
+	bic r3, r3, #1
+	str r3, [r8]
+.Lwait_normal_state:
+	ldr r3, [r9]
+	and r3, r3, #7
+	cmp r3, #1
+	bne .Lwait_normal_state
+	movs r0, #15
+	bl __usdelay
+	cmp r4, #1
+	bne .Ltraining_result
+	ldr r3, [r5]
+	mov r0, r4
+	bic r3, r3, #0xc0
+	str r3, [r5]
+	ldr r3, [r6]
+	bic r3, r3, #0x06000000
+	orr r3, r3, #0x02000000
+	str r3, [r6]
+	bl __usdelay
+	ldr r3, =PHY_PIR
+	movw r2, #0x401
+	str r2, [r3]
+.Lwait_resume_idone:
+	ldr r3, [r7]
+	lsls r2, r3, #31
+	bpl .Lwait_resume_idone
+.Ltraining_result:
+	/* Cache PGSR0 once: separate reads could observe different status. */
+	ldr r5, [r7]
+	tst r5, #0x0ff00000
+	beq .Ltraining_ok
+	ands r5, r5, #0x00100000
+	beq .Lfinish_channel
+	movs r5, #0
+	ldr r0, =dram_zq_calibration_error
+	bl printf
+.Lreturn:
+	mov r0, r5
+	pop {r3, r4, r5, r6, r7, r8, r9, pc}
+
+.Lgate_mode_two:
+	ldr r3, [r5]
+	ldr r1, =PHY_DQS_DELAY
+	bic r3, r3, #0xc0
+	orr r3, r3, #0x80
+	str r3, [r5]
+	ldr r3, =PHY_DRAMTMG2
+	ldr r3, [r3]
+	ldr r2, [r1]
+	ubfx r3, r3, #16, #5
+	bic r2, r2, #0x106
+	subs r3, #2
+	bic r2, r2, #1
+	orr r2, r2, #0x100
+	orrs r3, r2
+	ldr r2, =PHY_DXCCR
+	str r3, [r1]
+	ldr r3, [r2]
+	bic r3, r3, #0x80000000
+	orr r3, r3, #0x08000000
+	b .Lwrite_gate_delay
+.Lother_initialization:
+	ldr r3, =RTC_STANDBY
+	ldr r3, [r3]
+	lsls r3, r3, #15
+	bmi .Lresume_initialization
+	ldr r3, [r6, #DRAM_TYPE]
+	cmp r3, #3
+	ite ne
+	movne r3, #0x172
+	moveq r3, #0x1f2
+	b .Lstart_initialization
+.Lresume_initialization:
+	movs r3, #0x62
+	b .Lstart_initialization
+
+/* Safe literal-pool boundary: preceding initialization paths branch away. */
+.p2align 2
+.ltorg
+
+.Ltraining_ok:
+	movs r5, #1
+.Lfinish_channel:
+	ldr r2, =PHY_STATUS
+.Lwait_channel_normal:
+	ldr r3, [r2]
+	lsls r3, r3, #31
+	bpl .Lwait_channel_normal
+	ldr r6, =PHY_REFRESH
+	movs r0, #10
+	ldr r3, [r6]
+	orr r3, r3, #0x80000000
+	str r3, [r6]
+	bl __usdelay
+	ldr r3, [r6]
+	movs r0, #10
+	bic r3, r3, #0x80000000
+	str r3, [r6]
+	bl __usdelay
+	ldr r2, =COM_CLOCK_CTRL
+	movs r0, #10
+	ldr r3, [r2]
+	orr r3, r3, #0x80000000
+	str r3, [r2]
+	bl __usdelay
+	ldr r2, =PHY_REG_10C
+	cmp r4, #1
+	ldr r3, [r2]
+	bic r3, r3, #0x06000000
+	str r3, [r2]
+	itttt eq
+	ldreq r3, [r2, #16]
+	biceq r3, r3, #0xc0
+	orreq r3, r3, #0x40
+	streq r3, [r2, #16]
+	b .Lreturn
+.p2align 2
+.ltorg
+.size mctl_channel_init, . - mctl_channel_init
+.section .note.GNU-stack,"",%progbits
--- /dev/null
+++ b/drivers/dram/sun8iw20p1/lib-dram/mctl_phy_ac_remapping.S
@@ -0,0 +1,352 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/* Reconstructed T113 DRAM address/command remapping algorithm.
+ * r6: parameter block; r4: DRAM eFuse type; r5: chip mark.
+ * Nine local 22-byte maps occupy word-aligned stack slots. The zero map
+ * is the default; board/eFuse selection copies one of eight source tables.
+ */
+.syntax unified
+.arch armv7-a
+.thumb
+.equ SID_SRAM_BASE, 0x03006200
+.equ DRAM_REMAP0, 0x03102500
+.equ DRAM_REMAP1, 0x03102504
+.equ DRAM_REMAP2, 0x03102508
+.equ DRAM_REMAP3, 0x0310250c
+.section .text.mctl_phy_ac_remapping,"ax",%progbits
+.p2align 2
+.global mctl_phy_ac_remapping
+.type mctl_phy_ac_remapping,%function
+.thumb_func
+mctl_phy_ac_remapping:
+    ldr r3, =SID_SRAM_BASE
+    movs r2, #0x16
+    push {r4, r5, r6, lr}
+    sub sp, #0xd8
+    mov r6, r0
+    movs r1, #0
+    mov r0, sp
+    ldr r5, [r3]
+    ldr r4, [r3, #0x28]
+    bl memset
+    movs r2, #0x16
+    ldr r1, =dram_remap_cfg1
+    add r0, sp, #0x18
+    ubfx r4, r4, #8, #4
+    bl memcpy
+    movs r2, #0x16
+    ldr r1, =dram_remap_cfg2
+    add r0, sp, #0x30
+    ubfx r5, r5, #8, #8
+    bl memcpy
+    movs r2, #0x16
+    ldr r1, =dram_remap_cfg3
+    add r0, sp, #0x48
+    bl memcpy
+    movs r2, #0x16
+    ldr r1, =dram_remap_cfg4
+    add r0, sp, #0x60
+    bl memcpy
+    movs r2, #0x16
+    ldr r1, =dram_remap_cfg5
+    add r0, sp, #0x78
+    bl memcpy
+    movs r2, #0x16
+    ldr r1, =dram_remap_cfg6
+    add r0, sp, #0x90
+    bl memcpy
+    movs r2, #0x16
+    ldr r1, =dram_remap_cfg7
+    add r0, sp, #0xa8
+    bl memcpy
+    movs r2, #0x16
+    ldr r1, =dram_remap_cfg8
+    add r0, sp, #0xc0
+    bl memcpy
+    mov r1, r4
+    ldr r0, =dram_efuse_type
+    bl printf
+    mov r1, r5
+    ldr r0, =dram_mark_id
+    bl printf
+    ldr r3, [r6, #0x5c]
+    tst.w r3, #0xc0000
+    bne.n .Lremap_forced_remap
+    cmp r5, #0x50
+    beq.n .Lremap_forced_remap
+    cmp r5, #0x7c
+    beq.n .Lremap_forced_remap
+    sub.w r3, r4, #8
+    cmp r3, #6
+    bhi.n .Lremap_fuse_default
+    tbb [pc, r3]
+.Lremap_fuse_table:
+    .byte (.Lremap_fuse_8-.Lremap_fuse_table)/2
+    .byte (.Lremap_fuse_9-.Lremap_fuse_table)/2
+    .byte (.Lremap_fuse_10-.Lremap_fuse_table)/2
+    .byte (.Lremap_fuse_default-.Lremap_fuse_table)/2
+    .byte (.Lremap_fuse_12-.Lremap_fuse_table)/2
+    .byte (.Lremap_check_dram_type-.Lremap_fuse_table)/2
+    .byte (.Lremap_check_dram_type-.Lremap_fuse_table)/2
+    .p2align 1
+
+.Lremap_fuse_12:
+    movs r2, #0x16
+    add r1, sp, #0x18
+
+.Lremap_copy_selected_table:
+    mov r0, sp
+    bl memcpy_self
+
+.Lremap_check_dram_type:
+    ldr r3, [r6, #4]
+    cmp r3, #2
+    beq.n .Lremap_ddr2_mark_check
+    cmp r3, #3
+    beq.w .Lremap_program_common_map
+
+.Lremap_return:
+    add sp, #0xd8
+    pop {r4, r5, r6, pc}
+
+.Lremap_fuse_8:
+    movs r2, #0x16
+    add r1, sp, #0x30
+    b.n .Lremap_copy_selected_table
+
+.Lremap_fuse_9:
+    movs r2, #0x16
+    add r1, sp, #0x48
+    b.n .Lremap_copy_selected_table
+
+.Lremap_fuse_10:
+    movs r2, #0x16
+    add r1, sp, #0x78
+    b.n .Lremap_copy_selected_table
+
+.Lremap_fuse_default:
+    movs r2, #0x16
+    add r1, sp, #0x60
+    b.n .Lremap_copy_selected_table
+
+.Lremap_forced_remap:
+    lsls r2, r3, #0xd
+    bmi.n .Lremap_mark_50_table
+    cmp r5, #0x50
+    bne.n .Lremap_check_mark_7c
+
+.Lremap_mark_50_table:
+    movs r2, #0x16
+    add r1, sp, #0xa8
+    mov r0, sp
+    bl memcpy_self
+
+.Lremap_check_mark_7c:
+    ldr r3, [r6, #0x5c]
+    lsls r3, r3, #0xc
+    bmi.n .Lremap_mark_7c_table
+    cmp r5, #0x7c
+    bne.n .Lremap_check_dram_type
+
+.Lremap_mark_7c_table:
+    movs r2, #0x16
+    add r1, sp, #0xc0
+    b.n .Lremap_copy_selected_table
+
+.Lremap_ddr2_mark_check:
+    cmp r5, #0x50
+    beq.n .Lremap_program_ddr2_map
+    cmp r5, #0x7c
+    bne.n .Lremap_check_ddr2_die
+
+.Lremap_program_ddr2_map:
+    /* DDR2 marked dies: write the four packed line-mapping registers. */
+    ldrb.w r3, [sp, #1]
+    ldrb.w r2, [sp]
+    lsls r3, r3, #0xa
+    orr.w r3, r3, r2, lsl #5
+    ldrb.w r2, [sp, #2]
+    orr.w r3, r3, r2, lsl #15
+    ldrb.w r2, [sp, #3]
+    orr.w r3, r3, r2, lsl #20
+    ldrb.w r2, [sp, #4]
+    orr.w r3, r3, r2, lsl #25
+    ldr r2, =DRAM_REMAP0
+    str r3, [r2]
+    ldrb.w r3, [sp, #7]
+    ldrb.w r1, [sp, #6]
+    lsls r3, r3, #0xa
+    orr.w r3, r3, r1, lsl #5
+    ldrb.w r1, [sp, #5]
+    orrs r3, r1
+    ldrb.w r1, [sp, #8]
+    orr.w r3, r3, r1, lsl #15
+    ldrb.w r1, [sp, #9]
+    orr.w r3, r3, r1, lsl #20
+    ldrb.w r1, [sp, #0xa]
+    orr.w r3, r3, r1, lsl #25
+    ldr r1, =DRAM_REMAP1
+    str r3, [r1]
+    ldrb.w r3, [sp, #0xd]
+    ldrb.w r1, [sp, #0xc]
+    lsls r3, r3, #0xa
+    orr.w r3, r3, r1, lsl #5
+    ldrb.w r1, [sp, #0xb]
+    orrs r3, r1
+    ldrb.w r1, [sp, #0xe]
+    orr.w r3, r3, r1, lsl #15
+    ldrb.w r1, [sp, #0xf]
+    orr.w r3, r3, r1, lsl #20
+    ldr r1, =DRAM_REMAP2
+    str r3, [r1]
+    ldrb.w r3, [sp, #0x12]
+    ldrb.w r1, [sp, #0x11]
+    lsls r3, r3, #0xa
+    orr.w r3, r3, r1, lsl #5
+    ldrb.w r1, [sp, #0x10]
+    orrs r3, r1
+    ldrb.w r1, [sp, #0x13]
+    orr.w r3, r3, r1, lsl #15
+    ldrb.w r1, [sp, #0x14]
+    orr.w r3, r3, r1, lsl #20
+    ldrb.w r1, [sp, #0x15]
+    orr.w r3, r3, r1, lsl #25
+    ldr r1, =DRAM_REMAP3
+    str r3, [r1]
+    ldrb.w r3, [sp, #1]
+    ldrb.w r1, [sp]
+    lsls r3, r3, #0xa
+    orr.w r3, r3, r1, lsl #5
+    ldrb.w r1, [sp, #2]
+    orr r3, r3, #1
+    orr.w r3, r3, r1, lsl #15
+    ldrb.w r1, [sp, #3]
+    orr.w r3, r3, r1, lsl #20
+    ldrb.w r1, [sp, #4]
+    orr.w r3, r3, r1, lsl #25
+    str r3, [r2]
+
+.Lremap_check_ddr2_die:
+    subs r4, #0xd
+    cmp r4, #1
+    bhi.w .Lremap_return
+    movs r2, #0x16
+    add r1, sp, #0x90
+    mov r0, sp
+    bl memcpy_self
+
