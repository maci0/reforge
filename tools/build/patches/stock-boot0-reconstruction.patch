+    lsls r3, r3, #0xa
+    orr.w r3, r3, r1, lsl #5
+    ldrb.w r1, [sp, #5]
+    orrs r3, r1
+    ldrb.w r1, [sp, #8]
+    orr.w r3, r3, r1, lsl #15
+    ldrb.w r1, [sp, #9]
+    orr.w r3, r3, r1, lsl #20
+    ldrb.w r1, [sp, #0xa]
+    orr.w r3, r3, r1, lsl #25
+    ldr r1, =DRAM_REMAP1
+    str r3, [r1]
+    ldrb.w r3, [sp, #0xd]
+    ldrb.w r1, [sp, #0xc]
+    lsls r3, r3, #0xa
+    orr.w r3, r3, r1, lsl #5
+    ldrb.w r1, [sp, #0xb]
+    orrs r3, r1
+    ldrb.w r1, [sp, #0xe]
+    orr.w r3, r3, r1, lsl #15
+    ldrb.w r1, [sp, #0xf]
+    orr.w r3, r3, r1, lsl #20
+    ldr r1, =DRAM_REMAP2
+    str r3, [r1]
+    ldrb.w r3, [sp, #0x12]
+    ldrb.w r1, [sp, #0x11]
+    lsls r3, r3, #0xa
+    orr.w r3, r3, r1, lsl #5
+    ldrb.w r1, [sp, #0x10]
+    orrs r3, r1
+    ldrb.w r1, [sp, #0x13]
+    orr.w r3, r3, r1, lsl #15
+    ldrb.w r1, [sp, #0x14]
+    orr.w r3, r3, r1, lsl #20
+    ldrb.w r1, [sp, #0x15]
+    orr.w r3, r3, r1, lsl #25
+    ldr r1, =DRAM_REMAP3
+    str r3, [r1]
+    ldrb.w r3, [sp, #1]
+    ldrb.w r1, [sp]
+    lsls r3, r3, #0xa
+    orr.w r3, r3, r1, lsl #5
+    ldrb.w r1, [sp, #2]
+    orr r3, r3, #1
+    orr.w r3, r3, r1, lsl #15
+    ldrb.w r1, [sp, #3]
+    orr.w r3, r3, r1, lsl #20
+    ldrb.w r1, [sp, #4]
+    orr.w r3, r3, r1, lsl #25
+    str r3, [r2]
