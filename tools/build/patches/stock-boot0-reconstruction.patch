+/* Reconstructed T113 DRAM rank/data-width detection.
+ * r0: dram_para_t *, whose dram_para2 field is at byte 20.
+ * Success returns 1; an unrecognized training state returns 0.
+ */
+.syntax unified
+.arch armv7-a
+.thumb
+
+.equ MCTL_PGSR0, 0x03103010
+.equ MCTL_DX0GSR0, 0x03103348
+.equ DRAM_PARA2, 20
+.equ DRAM_TPR13, 92
+
+.section .text.dqs_gate_detect,"ax",%progbits
+.p2align 2
+.global dqs_gate_detect
+.type dqs_gate_detect, %function
+.thumb_func
+dqs_gate_detect:
+	ldr r3, =MCTL_PGSR0
+	push {r4, lr}
+	ldr r3, [r3]
+	lsls r3, r3, #9              /* Test training error bit 22. */
+	bpl .Ltwo_full
+
+	ldr r3, =MCTL_DX0GSR0
+	ldr r1, [r3]
+	ldr r4, [r3, #128]          /* DX1 status, same field. */
+	ubfx r1, r1, #24, #2
+	cmp r1, #2
+	ubfx r4, r4, #24, #2
+	bne .Lother_state
+
+	/* State 2 on DX0 means one rank; DX1 selects full or half DQ. */
+	ldr r3, [r0, #DRAM_PARA2]
+	cmp r4, #2
+	bic r3, r3, #0xf000
+	bic r3, r3, #0xf
+	bne .Lsingle_half
+	str r3, [r0, #DRAM_PARA2]
+	ldr r0, =dram_dqs_single_full
+	b .Ldetected
+
+.Ltwo_full:
+	ldr r3, [r0, #DRAM_PARA2]
+	bic r3, r3, #0xf
+	orr r3, r3, #0x1000
+	str r3, [r0, #DRAM_PARA2]
+	ldr r0, =dram_dqs_two_full
+.Ldetected:
+	bl printf
+	movs r0, #1
+.Lreturn:
+	pop {r4, pc}
+
+.Lsingle_half:
+	orr r3, r3, #1
+	str r3, [r0, #DRAM_PARA2]
+	ldr r0, =dram_dqs_single_half
+	b .Ldetected
+
+.Lother_state:
+	cbnz r1, .Lfailed
+	ldr r3, [r0, #DRAM_PARA2]
+	bic r3, r3, #0xf
+	orr r3, r3, #0x1000
+	orr r3, r3, #1
+	str r3, [r0, #DRAM_PARA2]
+	ldr r0, =dram_dqs_two_half
+	b .Ldetected
+
+.Lfailed:
+	/* Debug output is conditional; the returned value is always zero. */
+	ldr r0, [r0, #DRAM_TPR13]
+	ands r0, r0, #0x20000000
+	beq .Lreturn
+	ldr r0, =dram_dqs_dx0_state
+	bl printf
+	mov r1, r4
+	ldr r0, =dram_dqs_dx1_state
+	bl printf
+	movs r0, #0
+	b .Lreturn
+
+/* Thumb literal loads require a word-aligned pool. */
+.p2align 2
+.ltorg
+.size dqs_gate_detect, . - dqs_gate_detect
+.section .note.GNU-stack,"",%progbits
