+/* SPDX-License-Identifier: GPL-2.0+ */
+/* Reconstructed DRAM geometry probe: per-rank alternating address patterns,
+ * row aliasing, bank aliasing, column aliasing, and parameter writeback.
+ * r7: parameter block; r5: rank; r6: reference-pattern base;
+ * r8: current mapping's test base; fp: packed-parameter halfword shift.
+ */
+.syntax unified
+.arch armv7-a
+.thumb
+.equ DRAM_COM_WORK_MODE, 0x03102000
+.equ DRAM_WORK_MODE_GEOMETRY_MASK, 0xfffff003
+.equ DRAM_BASE, 0x40000000
+.equ SECOND_RANK_BASE, 0x48000000
+.equ RANK1_BANK_TEST_BASE, 0x40800000
+.equ RANK1_PAGE_TEST_BASE, 0x44000000
+.section .text.auto_scan_dram_size,"ax",%progbits
+.p2align 2
+.global auto_scan_dram_size
+.type auto_scan_dram_size,%function
+.thumb_func
+auto_scan_dram_size:
+    push.w {r0, r1, r2, r4, r5, r6, r7, r8, sb, sl, fp, lr}
+    mov r7, r0
+    bl mctl_core_init
+    mov r4, r0
+    cbnz r0, .Lscan_select_rank_count
+    ldr r0, .Lscan_initial_error
+    bl printf
+
+.Lscan_return_result:
+    mov r0, r4
+    add sp, #0xc
+    pop.w {r4, r5, r6, r7, r8, sb, sl, fp, pc}
+
+.Lscan_select_rank_count:
+    ldr r3, [r7, #0x14]
+    mov.w r6, #DRAM_BASE
+    ldr.w sl, .Lscan_geometry_mask
+    movs r5, #0
+    mov r8, r6
+    ubfx r3, r3, #0xc, #4
+    cmp r3, #1
+    ite eq
+    moveq r3, #2
+    movne r3, #1
+    str r3, [sp, #4]
+
+.Lscan_write_rank_pattern:
+    mov r2, r8
+    movs r3, #0
+    mvn.w r0, r8
+
+.Lscan_pattern_word:
+    lsls r4, r3, #0x1f
+    it pl
+    subpl.w r1, r0, r3, lsl #2
+    add.w r3, r3, #1
+    it mi
+    movmi r1, r2
+    cmp r3, #0x40
+    str r1, [r2], #4
+    bne.n .Lscan_pattern_word
+    add.w r4, r5, #0xc40000
+    add.w r4, r4, #0x800
+    lsls r4, r4, #2
+    ldr r3, [r4]
+    bic r3, r3, #0xf00
+    bic r3, r3, #0xc
+    orr r3, r3, #0x6f0
+    str r3, [r4]
+
+.Lscan_wait_row_mode:
+    ldr r2, [r4]
+    cmp r3, r2
+    bne.n .Lscan_wait_row_mode
+    mov.w sb, #0xb
+    mov.w ip, #1
+    mvn.w lr, r6
+
+.Lscan_row_candidate:
+    add.w r3, sb, #0xb
+    mov r1, r6
+    lsl.w r3, ip, r3
+    movs r2, #0
+    add r3, r8
+    subs r3, r3, r6
+
+.Lscan_row_pattern_word:
+    lsls r0, r2, #0x1f
+    ldr.w fp, [r3, r1]
+    ite pl
+    subpl.w r0, lr, r2, lsl #2
+    movmi r0, r1
+    cmp fp, r0
+    bne.w .Lscan_next_row_candidate
+    adds r2, #1
+    adds r1, #4
+    cmp r2, #0x40
+    bne.n .Lscan_row_pattern_word
+
+.Lscan_record_row_count:
+    lsl.w fp, r5, #4
+    mov r2, sb
+    mov r1, r5
+    ldr r0, .Lscan_row_message
+    bl printf
+    add.w r2, fp, #4
+    movs r3, #0xff
+    lsl.w r1, r3, r2
+    ldr r3, [r7, #0x10]
+    lsl.w sb, sb, r2
+    cmp r5, #1
+    bic.w r3, r3, r1
+    orr.w r3, r3, sb
+    str r3, [r7, #0x10]
+    bne.n .Lscan_configure_bank_mode
+    ldr r2, .Lscan_work_mode
+    mov.w r8, #RANK1_BANK_TEST_BASE
+    ldr r3, [r2]
+    and.w r3, r3, sl
+    orr r3, r3, #0x6a0
+    orr r3, r3, #4
+    str r3, [r2]
+
+.Lscan_configure_bank_mode:
+    ldr r3, [r4]
+    and.w r3, r3, sl
+    orr r3, r3, #0x6a0
+    orr r3, r3, #4
+    str r3, [r4]
+
+.Lscan_wait_bank_mode:
+    ldr r2, [r4]
+    cmp r2, r3
+    bne.n .Lscan_wait_bank_mode
+    add.w r2, r8, #0x800
+    movs r3, #0
+    mvn.w ip, r6
+
+.Lscan_bank_pattern_word:
+    lsls r0, r3, #2
+    tst.w r3, #1
+    add.w r1, r6, r0
+    it eq
+    subeq.w r1, ip, r0
+    ldr r0, [r2]
+    cmp r0, r1
+    bne.w .Lscan_eight_banks
+    adds r3, #1
+    adds r2, #4
+    cmp r3, #0x40
+    bne.n .Lscan_bank_pattern_word
+    mov.w sb, #0
+
+.Lscan_record_bank_count:
+    add.w r2, sb, #1
+    mov r1, r5
+    lsls r2, r2, #2
+    ldr r0, .Lscan_bank_message
+    bl printf
+    add.w r1, fp, #0xc
+    movs r3, #0xf
+    lsl.w r2, r3, r1
+    ldr r3, [r7, #0x10]
+    lsl.w sb, sb, r1
+    cmp r5, #1
+    bic.w r3, r3, r2
+    orr.w r3, r3, sb
+    str r3, [r7, #0x10]
+    bne.n .Lscan_configure_page_mode
+    ldr r2, .Lscan_work_mode
+    mov.w r8, #RANK1_PAGE_TEST_BASE
+    ldr r3, [r2]
+    and.w r3, r3, sl
+    orr r3, r3, #0xaa0
+    str r3, [r2]
+
+.Lscan_configure_page_mode:
+    ldr r3, [r4]
+    and.w r3, r3, sl
+    orr r3, r3, #0xaa0
+    str r3, [r4]
+
+.Lscan_wait_page_mode:
+    ldr r2, [r4]
+    cmp r2, r3
+    bne.n .Lscan_wait_page_mode
+    movs r3, #9
+    mov.w ip, #1
+    mvn.w lr, r6
+
+.Lscan_column_candidate:
+    lsl.w r1, ip, r3
+    mov r0, r6
+    movs r2, #0
+    add r1, r8
+    subs r1, r1, r6
+
+.Lscan_column_pattern_word:
+    lsls r4, r2, #0x1f
+    ldr.w sb, [r1, r0]
+    ite pl
+    subpl.w r4, lr, r2, lsl #2
+    movmi r4, r0
+    cmp sb, r4
+    bne.n .Lscan_next_column_candidate
+    adds r2, #1
+    adds r0, #4
+    cmp r2, #0x40
+    bne.n .Lscan_column_pattern_word
+    cmp r3, #0xd
+    beq.n .Lscan_column_size
+    cmp r3, #9
+    beq.n .Lscan_smallest_page
+
+.Lscan_column_size:
+    subs r3, #0xa
+    movs r4, #1
+    lsls r4, r3
+
+.Lscan_record_page_size:
+    mov r2, r4
+    ldr r0, .Lscan_page_message
+    mov r1, r5
+    lsl.w r4, r4, fp
+    adds r5, #1
+    bl printf
+    movs r3, #0xf
+    lsl.w r2, r3, fp
+    ldr r3, [r7, #0x10]
+    bic.w r3, r3, r2
+    orrs r4, r3
+    ldr r3, [sp, #4]
+    str r4, [r7, #0x10]
+    cmp r3, r5
+    bne.n .Lscan_advance_rank
+    cmp r3, #2
+    bne.n .Lscan_success
+    ldr r3, [r7, #0x14]
+    uxth r2, r4
+    cmp.w r2, r4, lsr #16
+    bic r3, r3, #0xf00
+    iteet ne
+    orrne r3, r3, #0x100
+    streq r3, [r7, #0x14]
