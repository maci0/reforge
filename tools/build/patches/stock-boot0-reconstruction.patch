+++ b/drivers/dram/sun8iw20p1/lib-dram/dramc_simple_wr_test.S
@@ -0,0 +1,86 @@
+/* Reconstructed T113 destructive DRAM test, preserving the vendor contract.
+ * r0: total memory in MiB; r1: number of words to test in each half.
+ * Write distinct incrementing patterns to both regions, then verify the
+ * second region before the first. Return 0 on success, 1 on mismatch.
+ */
+.syntax unified
+.arch armv7-a
+.thumb
+.equ SDRAM_BASE, 0x40000000
+.equ TEST_PATTERN_A, 0x01234567
+.equ TEST_PATTERN_B, 0xfedcba98
+
+.section .text.dramc_simple_wr_test,"ax",%progbits
+.p2align 2
+.global dramc_simple_wr_test
+.type dramc_simple_wr_test, %function
+.thumb_func
+dramc_simple_wr_test:
+	lsrs r0, r0, #1
+	push {r3, r4, r5, r6, r7, r8, r9, lr}
+	ldr r2, =TEST_PATTERN_A
+	mov r3, #SDRAM_BASE
+	lsls r0, r0, #20             /* Offset to the second half, in bytes. */
+	movs r4, #0
+	ldr r5, =TEST_PATTERN_B
+.Lwrite_next:
+	cmp r4, r1
+	bne .Lwrite_word
+	ldr r2, =TEST_PATTERN_B
+	mov r6, #SDRAM_BASE
+	ldr r1, =TEST_PATTERN_A
+	movs r5, #0
+.Lverify_next:
+	cmp r4, r5
+	bne .Lverify_word
+	ldr r0, =dram_test_ok
+	bl printf
+	movs r0, #0
+	b .Lreturn
+
+.Lwrite_word:
+	adds r6, r4, r2
+	str r6, [r3]
+	adds r6, r4, r5
+	str r6, [r0, r3]
+	adds r4, #1
+	adds r3, #4
+	b .Lwrite_next
+
+.Lverify_word:
+	ldr r7, [r0, r6]
+	add r8, r5, r2
+	add r9, r0, r6
+	cmp r8, r7
+	beq .Lverify_first_half
+	ldr r0, =dram_test_fail
+	bl printf
+	mov r3, r9
+.Lreport_values:
+	mov r2, r8
+	mov r1, r7
+	ldr r0, =dram_test_mismatch
+	bl printf
+	movs r0, #1
+.Lreturn:
+	pop {r3, r4, r5, r6, r7, r8, r9, pc}
+
+.Lverify_first_half:
+	mov r3, r6
+	add r8, r5, r1
+	ldr r7, [r3], #4
+	cmp r8, r7
+	beq .Lverified_word
+	ldr r0, =dram_test_fail
+	bl printf
+	mov r3, r6
+	b .Lreport_values
+.Lverified_word:
+	adds r5, #1
+	mov r6, r3
+	b .Lverify_next
+
+.p2align 2
+.ltorg
+.size dramc_simple_wr_test, . - dramc_simple_wr_test
+.section .note.GNU-stack,"",%progbits
