+++ b/drivers/dram/sun8iw20p1/lib-dram/chip_id_sd.c
@@ -0,0 +1,32 @@
+/* Source reconstruction of the boot0 SD chip-identification helpers. */
+typedef unsigned char u8;
+typedef unsigned short u16;
+typedef unsigned int u32;
+
+u16 crc_16(u16 value, u8 datum)
+{
+	u16 bit;
+	value ^= datum << 8;
+	for (bit = 8; bit > 0; bit--) {
+		u16 high = value & 0x8000;
+		value = (u16)(value << 1);
+		if (high)
+			value = (u16)(value ^ (short)0x8005);
+	}
+	return value;
+}
+
+u32 disturb_coding(u16 value, u8 datum)
+{
+	u32 sum = value + datum;
+	return sum | ((u32)crc_16(value, datum) << 16);
+}
+
+u32 id_judge_fun(u16 value)
+{
+	volatile u32 status = 0;
+	status = *(volatile u32 *)0x01c15004 & 7;
+	if (!status)
+		return disturb_coding(value, 1);
+	return 0;
+}
