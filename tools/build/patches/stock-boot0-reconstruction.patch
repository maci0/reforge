+++ b/drivers/sid.c
@@ -0,0 +1,44 @@
+/* Reconstructed stock SID transaction protocol from original boot0. */
+#include <common.h>
+#include <asm/io.h>
+#include <arch/efuse.h>
+
+void sid_read_work_status(void)
+{
+	while (readl(0x03006040) & (1 << 3))
+		;
+}
+
+u32 sid_read_key(u32 key_index)
+{
+	u32 reg;
+	sid_read_work_status();
+	reg = readl(0x03006040);
+	reg &= 0xfe00fffc;
+	reg |= key_index << 16;
+	writel(reg, 0x03006040);
+	writel((reg & 0xffff00fc) | 0xac02, 0x03006040);
+	while (readl(0x03006040) & 2)
+		;
+	reg &= 0xfe0000fc;
+	writel(reg, 0x03006040);
+	return readl(0x03006060);
+}
+
+void sid_program_key(u32 key_index, u32 key_value)
+{
+	u32 reg;
+	setbits_le32(0x07090204, 1);
+	sid_read_work_status();
+	writel(key_value, 0x03006050);
+	reg = readl(0x03006040);
+	reg &= 0xfe00fffc;
+	reg |= key_index << 16;
+	writel(reg, 0x03006040);
+	writel((reg & 0xffff00fc) | 0xac01, 0x03006040);
+	while (readl(0x03006040) & 1)
+		;
+	reg &= 0xfe0000fc;
+	writel(reg, 0x03006040);
+	clrbits_le32(0x07090204, 1);
+}
