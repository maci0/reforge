+++ b/drivers/dram/sun8iw20p1/lib-dram/init_DRAM.S
@@ -0,0 +1,292 @@
+/* SPDX-License-Identifier: GPL-2.0+ */
+/* Reconstructed T113 V0.32 DRAM bringup orchestration.
+ * r4 is the parameter block; r5 holds PMIC availability, then detected MiB.
+ * Preserve the board's ordered ZQ/PMIC transactions and timed delays.
+ */
+.syntax unified
+.arch armv7-a
+.thumb
+.equ ZQ_CONTROL, 0x03000160
+.equ RTC_ZQ_STATUS, 0x07010254
+.equ ZQ_RESULT, 0x0300016c
+.equ ZQ_INTERNAL_CONTROL, 0x03000168
+.equ DRAM_AUTO_REFRESH, 0x031030a0
+.equ DRAM_POWER_CONTROL, 0x03103004
+.equ AUTO_REFRESH_DEFAULT, 0x10000200
+.equ DRAM_REFRESH_TIMING, 0x0310309c
+.equ DRAM_PHY_CONTROL_100, 0x03103100
+.equ DRAM_PHY_CONTROL_140, 0x03103140
+.equ DRAM_PHY_CONTROL_108, 0x03103108
+.equ DRAM_TIMING_07C, 0x0310307c
+.equ PLL_DDR_CONTROL, 0x02001010
+.equ DRAM_CLOCK_CONTROL, 0x02001800
+.equ RTC_STANDBY_FLAG, 0x070005d4
+.equ PARA_TYPE, 4
+.equ PARA_ORG2, 20
+.equ PARA_MR2, 32
+.equ PARA_TPR8, 72
+.equ PARA_TPR13, 92
+.section .text.init_DRAM,"ax",%progbits
+.p2align 2
+.global init_DRAM
+.type init_DRAM,%function
+.thumb_func
+init_DRAM:
+    push {r3, r4, r5, lr}
+    mov r4, r1
+    ldr r3, [r1, #0x5c]
+    ldr r5, =ZQ_CONTROL
+    ands r3, r3, #0x10000
+    bne.n .Linit_internal_zq_only
+    ldr r2, =RTC_ZQ_STATUS
+    movs r0, #0xa
+    str r3, [r2]
+    ldr r3, [r5]
+    bic r3, r3, #3
+    str r3, [r5]
+    bl __usdelay
+    ldr r3, [r5]
+    movs r0, #0xa
+    bic r3, r3, #0x108
+    str r3, [r5]
+    ldr r3, [r5]
+    orr r3, r3, #2
+    str r3, [r5]
+    bl __usdelay
+    ldr r3, [r5]
+    movs r0, #0x14
+    orr r3, r3, #1
+    str r3, [r5]
+    bl __usdelay
+    ldr r3, =ZQ_RESULT
+    ldr r0, =dram_internal_zq_value
+    ldr r1, [r3]
+    bl printf
+
+.Linit_probe_pmic:
+    bl get_pmu_exist
+    mov r5, r0
+    mov r1, r0
+    ldr r0, =dram_pmu_exists
+    bl printf
+    cmp r5, #0
+    bge.n .Linit_select_pmic_voltage
+    mov r0, r4
+    bl dram_vol_set
+
+.Linit_check_automatic_scan:
+    ldr r3, [r4, #PARA_TPR13]
+    lsls r1, r3, #0x1f
+    bpl.n .Linit_scan_configuration
+
+.Linit_print_parameters:
+    ldr r1, =dram_driver_version
+    ldr r0, =dram_boot_driver_info
+    bl printf
+    ldr r1, [r4]
+    ldr r0, =dram_clock_mhz
+    bl printf
+    ldr r1, [r4, #PARA_TYPE]
+    ldr r0, =dram_type_info
+    bl printf
+    ldr r3, [r4, #0xc]
+    lsls r2, r3, #0x1f
+    bmi.n .Linit_print_zq_value
+    ldr r0, =dram_read_odt_off
+    bl printf
+    b.n .Linit_print_odt
+
+.Linit_internal_zq_only:
+    ldr r0, =dram_internal_zq_only
+    bl printf
+    ldr r3, [r5]
+    movs r2, #0
+    movs r0, #0xa
+    orr r3, r3, #0x100
+    str r3, [r5]
+    ldr r3, =ZQ_INTERNAL_CONTROL
+    str r2, [r3]
+    bl __usdelay
+    b.n .Linit_probe_pmic
+
+.Linit_select_pmic_voltage:
+    ldr r3, [r4, #PARA_TYPE]
+    cmp r3, #2
+    beq.n .Linit_ddr2_voltage
+    cmp r3, #3
+    bne.n .Linit_check_automatic_scan
+    movw r0, #0x5dc
+    b.n .Linit_apply_pmic_voltage
+
+.Linit_ddr2_voltage:
+    mov.w r0, #0x708
+
+.Linit_apply_pmic_voltage:
+    bl set_ddr_voltage
+    b.n .Linit_check_automatic_scan
+
+.Linit_scan_configuration:
+    mov r0, r4
+    bl auto_scan_dram_config
+    cmp r0, #0
+    bne.n .Linit_print_parameters
+
+.Linit_return_failure:
+    movs r0, #0
+
+.Linit_return:
+    pop {r3, r4, r5, pc}
+
+.Linit_print_zq_value:
+    ldr r1, [r4, #8]
+    ldr r0, =dram_zq_value
+    bl printf
+
+.Linit_print_odt:
+    ldr r1, [r4, #0x1c]
+    tst.w r1, #0x44
+    beq.n .Linit_print_odt_off
+    ldr r0, =dram_odt_value
+    bl printf
+
+.Linit_initialise_controller:
+    mov r0, r4
+    bl mctl_core_init
+    mov r5, r0
+    cbnz r0, .Linit_determine_size
+    ldr r0, =dram_initial_one_error
+    bl printf
+
+.Linit_return_size:
+    mov r0, r5
+    b.n .Linit_return
+
+.Linit_print_odt_off:
+    ldr r0, =dram_odt_off
+    bl printf
+    b.n .Linit_initialise_controller
+
+.Linit_determine_size:
+    ldr r5, [r4, #PARA_ORG2]
+    cmp r5, #0
+    bge.n .Linit_measure_size
+    ubfx r5, r5, #0x10, #0xf
+
+.Linit_configure_auto_refresh:
+    ldr r3, [r4, #PARA_TPR13]
+    ldr r1, =DRAM_AUTO_REFRESH
+    ldr r2, =DRAM_POWER_CONTROL
+    tst.w r3, #0x40000000
+    ldr r3, [r1]
+    beq.n .Linit_disable_auto_refresh
+    ldr r3, [r4, #PARA_TPR8]
+    ldr r0, =AUTO_REFRESH_DEFAULT
+    cmp r3, #0
+    it eq
+    moveq r3, r0
+    ldr r0, =dram_auto_sr_enabled
+    str r3, [r1]
+    movw r1, #0x40a
+    ldr r3, =DRAM_REFRESH_TIMING
+    str r1, [r3]
+    ldr r3, [r2]
+    orr r3, r3, #1
+    str r3, [r2]
+    bl printf
+
+.Linit_configure_phy:
+    ldr r2, =DRAM_PHY_CONTROL_100
+    ldr r1, [r4, #PARA_TPR13]
+    ldr r0, [r4, #PARA_TYPE]
+    ldr r3, [r2]
+    tst.w r1, #0x200
+    bic r3, r3, #0xf000
+    bne.n .Linit_enable_powerdown_timing
+    cmp r0, #6
+    bne.n .Linit_write_phy_control
+
+.Linit_enable_powerdown_timing:
+    orr r3, r3, #0x5000
+
+.Linit_write_phy_control:
+    str r3, [r2]
+    ldr r2, =DRAM_PHY_CONTROL_140
+    ldr r3, [r2]
+    orr r3, r3, #0x80000000
+    str r3, [r2]
+    lsls r3, r1, #0x17
+    ittt mi
+    ldrmi r3, [r2, #-0x88]
+    orrmi r3, r3, #0x300
+    strmi r3, [r2, #-0x88]
+    tst.w r1, #0x4000000
+    ldr r3, =DRAM_PHY_CONTROL_108
+    ldr r2, [r3]
+    ite ne
+    bicne r2, r2, #0x2000
+    orreq r2, r2, #0x2000
+    cmp r0, #7
+    str r2, [r3]
+    bne.n .Linit_print_final_registers
+    ldr r2, =DRAM_TIMING_07C
+    ldr r3, [r2]
+    bic r3, r3, #0xf0000
+    orr r3, r3, #0x10000
+    str r3, [r2]
+
+.Linit_print_final_registers:
+    ldr r3, =PLL_DDR_CONTROL
+    ldr r0, =dram_pll_ctrl
+    ldr r1, [r3]
+    bl printf
+    ldr r3, =DRAM_CLOCK_CONTROL
+    ldr r0, =dram_clk_ctrl
+    ldr r1, [r3]
+    bl printf
+    ldrh r1, [r4, #PARA_MR2]
+    ldr r0, =dram_timing_mr2
+    bl printf
+    bl dram_enable_all_master
+    ldr r3, [r4, #PARA_TPR13]
+    lsls r2, r3, #3
+    bmi.n .Linit_check_memory_test
+
+.Linit_resume_standby:
+    bl handler_super_standby
+    b.n .Linit_return_size
+
+.Linit_measure_size:
+    bl DRAMC_get_dram_size
+    mov r5, r0
+    mov r1, r0
+    ldr r0, =dram_size_mb
+    bl printf
+    ldrh r3, [r4, #PARA_ORG2]
+    orr.w r3, r3, r5, lsl #16
+    str r3, [r4, #PARA_ORG2]
+    b.n .Linit_configure_auto_refresh
+
+.Linit_disable_auto_refresh:
+    lsrs r3, r3, #0x10
+    lsls r3, r3, #0x10
+    str r3, [r1]
+    ldr r3, [r2]
+    bic r3, r3, #1
+    str r3, [r2]
+    b.n .Linit_configure_phy
+
+.Linit_check_memory_test:
+    ldr r3, =RTC_STANDBY_FLAG
+    ldr r3, [r3]
+    lsls r3, r3, #0xf
+    bmi.n .Linit_resume_standby
+    mov.w r1, #0x1000
+    mov r0, r5
+    bl dramc_simple_wr_test
+    cmp r0, #0
+    beq.n .Linit_resume_standby
+    b.n .Linit_return_failure
+    .p2align 2
+    .ltorg
+.size init_DRAM,.-init_DRAM
+.section .note.GNU-stack,"",%progbits
