+    ldr r3, [r2]
+    and.w r3, r3, sl
+    orr r3, r3, #0x6f0
+    str r3, [r2]
+    ldr r3, [r2, #4]
+    and.w r3, r3, sl
+    orr r3, r3, #0x6f0
+    orr r3, r3, #1
+    str r3, [r2, #4]
+    b.n .Lscan_write_rank_pattern
+
+.Lscan_eight_banks:
+    mov.w sb, #1
+    b.n .Lscan_record_bank_count
+
+.Lscan_smallest_page:
+    movs r4, #0
+    b.n .Lscan_record_page_size
+
+.Lscan_next_row_candidate:
+    add.w sb, sb, #1
+    cmp.w sb, #0x11
+    bne.w .Lscan_row_candidate
+    mov.w sb, #0x10
+    b.n .Lscan_record_row_count
+
+.Lscan_next_column_candidate:
+    adds r3, #1
+    cmp r3, #0xe
+    bne.n .Lscan_column_candidate
+    movs r3, #0xd
+    b.n .Lscan_column_size
