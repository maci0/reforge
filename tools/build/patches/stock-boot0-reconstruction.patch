+++ b/drivers/dram/sun8iw20p1/lib-dram/auto_set_timing_para.S
@@ -0,0 +1,865 @@
+/* Reconstructed T113 DRAM timing calculation and controller programming.
+ * r0: dram_para_t *. Honor supplied TPR timings when TPR13 bit 1 is set;
+ * otherwise calculate DDR2/DDR3/LPDDR2/LPDDR3 timings from the half clock.
+ * The second phase derives mode-register values and programs the controller.
+ * All branch tables contain symbolic label differences, not opcode bytes.
+ */
+.syntax unified
+.arch armv7-a
+.thumb
+.equ DDR2, 2
+.equ DDR3, 3
+.equ LPDDR2, 6
+.equ LPDDR3, 7
+.equ P_CLK,   0
+.equ P_TYPE,  4
+.equ P_ODT,   12
+.equ P_MR0,   24
+.equ P_MR1,   28
+.equ P_MR2,   32
+.equ P_MR3,   36
+.equ P_TPR0,  40
+.equ P_TPR1,  44
+.equ P_TPR2,  48
+.equ P_TPR4,  56
+.equ P_TPR13, 92
+/* Stack timing variables; FLAGS_OR_MR1 is reused after type selection. */
+.equ S_TRCD,       0
+.equ S_TXP,        4
+.equ S_TRRD,       8
+.equ S_TRC,        12
+.equ S_TFAW,       16
+.equ S_TRAS,       20
+.equ S_FLAGS_OR_MR1,24
+.equ S_MR3,        28
+.equ S_TCL,        32
+.equ S_TMOD,       36
+.equ S_TRFC,       40
+.equ S_WR_LATENCY, 44
+.equ S_TDINIT0,    48
+.equ S_TDINIT1,    52
+.equ S_TDINIT2,    56
+.equ S_TDINIT3,    60
+.equ S_MR0,        64
+.equ S_MR2,        68
+.equ S_TWTP,       72
+.equ S_TRASMAX,    76
+.equ S_TWR2RD,     80
+.equ S_SAVED_MR1,  84
+.equ S_TRTP,       88
+.equ S_SAVED_MR3,  92
+.equ S_TCCD,       96
+.equ S_TCL_PLUS2,  100
+.equ TIMING_FRAME, 108
+/* Reciprocal multiplication implements unsigned /30, /60, and /1000. */
+.equ DIV30_OR60_MULTIPLIER, 0x88888889
+.equ DIV1000_MULTIPLIER, 0x10624dd3
+.equ PHY_MR0,       0x03103030
+.equ PHY_PTR3,      0x03103050
+.equ PHY_PTR4,      0x03103054
+.equ PHY_DRAMTMG0,  0x03103058
+.equ PHY_DRAMTMG1,  0x0310305c
+.equ PHY_DRAMTMG2,  0x03103060
+.equ PHY_DRAMTMG4,  0x03103068
+.equ PHY_DRAMTMG5,  0x0310306c
+.equ PHY_RANK_TIMING,0x03103078
+.equ PHY_PITMG0,    0x03103080
+.equ PHY_REFRESH_CONFIG, 0x03103094
+.equ REFRESH_FIELD_MASK, 0x0fff0000
+
+.section .text.auto_set_timing_para,"ax",%progbits
+.p2align 2
+.global auto_set_timing_para
+.type auto_set_timing_para, %function
+.thumb_func
+auto_set_timing_para:
+	ldr r3, [r0, #P_TPR13]
+	push {r4, r5, r6, r7, r8, r9, r10, r11, lr}
+	sub sp, #TIMING_FRAME
+	ldr r9, [r0, #P_CLK]
+	mov r4, r0
+	lsls r1, r3, #30
+	str r3, [sp, #S_FLAGS_OR_MR1]
+	ldr r6, [r0, #P_TYPE]
+	lsr r8, r9, #1
+	bpl .Lcalculate_timings
+
+	/* Decode the supplied timing fields from TPR0, TPR1, and TPR2. */
+	ldr r3, [r0, #P_TPR0]
+	ubfx r2, r3, #21, #3
+	str r2, [sp, #S_TCCD]
+	ubfx r2, r3, #15, #6
+	str r2, [sp, #S_TFAW]
+	ubfx r2, r3, #11, #4
+	str r2, [sp, #S_TRRD]
+	ubfx r2, r3, #6, #5
+	and r3, r3, #0x3f
+	str r2, [sp, #S_TRCD]
+	str r3, [sp, #S_TRC]
+	ldr r3, [r0, #P_TPR1]
+	ldr r0, [r0, #P_TPR2]
+	ubfx r2, r3, #23, #5
+	ubfx r5, r3, #20, #3
+	str r2, [sp, #S_TXP]
+	ubfx r7, r3, #11, #4
+	ubfx r2, r3, #15, #5
+	ubfx r10, r3, #6, #5
+	ubfx r11, r0, #0, #12
+	and r3, r3, #0x3f
+	str r3, [sp, #S_TRAS]
+	ubfx r3, r0, #12, #9
+	str r2, [sp, #S_TRTP]
+	str r3, [sp, #S_TRFC]
+.Lselect_mode_values:
+	ldr r3, [r4, #P_MR3]
+	ldr r2, [r4, #P_CLK]
+	str r3, [sp, #S_SAVED_MR3]
+	ldr r3, [r4, #P_MR1]
+	str r3, [sp, #S_SAVED_MR1]
+	subs r3, r6, #DDR2
+	cmp r3, #(LPDDR3-DDR2)
+	bhi.w .Lmode_default
+	tbh [pc, r3, lsl #1]
+.Lmode_table:
+	.hword (.Lmode_ddr2-.Lmode_table)/2
+	.hword (.Lmode_ddr3-.Lmode_table)/2
+	.hword (.Lmode_default-.Lmode_table)/2
+	.hword (.Lmode_default-.Lmode_table)/2
+	.hword (.Lmode_lpddr2-.Lmode_table)/2
+	.hword (.Lmode_lpddr3-.Lmode_table)/2
+
+.Lcalculate_timings:
+	cmp r6, #DDR3
+	bne.w .Lcalculate_non_ddr3
+	/* DDR3: minimum two cycles for write-to-read and write recovery. */
+	mov r1, r8
+	movs r0, #8
+	bl auto_cal_timing
+	mov r1, r8
+	mov r5, r0
+	movs r0, #15
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TRCD]
+	movw r0, #7800
+	bl auto_cal_timing
+	ands r3, r0, #31
+	mov r1, r8
+	it ne
+	movne r3, #1
+	add r11, r3, r0, lsr #5
+	mov r0, #350
+	bl auto_cal_timing
+	ldr r7, [sp, #S_TRCD]
+	cmp r5, #2
+	it lo
+	movlo r5, #2
+	str r0, [sp, #S_TRFC]
+	mov r1, r8
+	cmp r7, #2
+	it lo
+	movlo r7, #2
+	cmp r9, #800
+	bhi .Lddr3_fast_timings
+	movs r0, #50
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TFAW]
+	movs r0, #10
+	bl auto_cal_timing
+	cmp r0, #2
+	mov r1, r8
+	it lo
+	movlo r0, #2
+	str r0, [sp, #S_TRRD]
+	movs r0, #53
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TRC]
+	movs r0, #38
+	bl auto_cal_timing
+	str r5, [sp, #S_TXP]
+	str r0, [sp, #S_TRAS]
+.Lsave_ddr3_trp:
+	ldr r10, [sp, #S_TRCD]
+.Lpack_calculated_timings:
+	/* TPR0 packs tCCD, tFAW, tRRD, tRCD, and tRC. */
+	ldr r2, [sp, #S_TRCD]
+	ldr r3, [sp, #S_TRC]
+	orr r3, r3, #0x400000
+	orr r3, r3, r2, lsl #6
+	ldr r2, [sp, #S_TRRD]
+	orr r3, r3, r2, lsl #11
+	ldr r2, [sp, #S_TFAW]
+	orr r3, r3, r2, lsl #15
+	ldr r2, [sp, #S_TRAS]
+	str r3, [r4, #P_TPR0]
+	lsls r3, r7, #11
+	orr r3, r3, r10, lsl #6
+	orrs r3, r2
+	ldr r2, [sp, #S_TXP]
+	orr r3, r3, r5, lsl #15
+	orr r3, r3, r5, lsl #20
+	orr r3, r3, r2, lsl #23
+	str r3, [r4, #P_TPR1]
+	ldr r3, [r4, #P_TPR4]
+	ubfx r3, r3, #12, #4
+	cmp r3, #1
+	beq.w .Lrefresh_half
+	cmp r3, #2
+	beq.w .Lrefresh_quarter
+	ldr r0, =dram_refresh_78ms
+	b .Lrefresh_report
+
+.Lddr3_fast_timings:
+	movs r0, #35
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TFAW]
+	movs r0, #6
+	bl auto_cal_timing
+	cmp r0, #2
+	mov r1, r8
+	it lo
+	movlo r0, #2
+	str r0, [sp, #S_TRRD]
+	movs r0, #14
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TRCD]
+	movs r0, #48
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TRC]
+	movs r0, #34
+	bl auto_cal_timing
+	ldr r3, [sp, #S_TRRD]
+	str r0, [sp, #S_TRAS]
+	str r3, [sp, #S_TXP]
+	b .Lsave_ddr3_trp
+
+.Lcalculate_non_ddr3:
+	cmp r6, #DDR2
+	bne .Lcalculate_non_ddr2
+	/* DDR2 timing limits in nanoseconds. */
+	mov r1, r8
+	movs r0, #50
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TFAW]
+	movs r0, #10
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TRRD]
+	movs r0, #20
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TRCD]
+	movs r0, #65
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TRC]
+	movs r0, #8
+	bl auto_cal_timing
+	mov r1, r8
+	mov r5, r0
+	movs r0, #15
+	bl auto_cal_timing
+	mov r1, r8
+	mov r10, r0
+	movs r0, #45
+	mov r7, r10
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TRAS]
+	movw r0, #7800
+	bl auto_cal_timing
+	ands r3, r0, #31
+	mov r1, r8
+	it ne
+	movne r3, #1
+	add r11, r3, r0, lsr #5
+	mov r0, #328
+	bl auto_cal_timing
+	str r6, [sp, #S_TXP]
+	str r0, [sp, #S_TRFC]
+	b .Lpack_calculated_timings
+
+.Lcalculate_non_ddr2:
+	cmp r6, #LPDDR2
+	bne .Lcalculate_non_lpddr2
+	/* LPDDR2 adds minimum-cycle constraints to the nanosecond limits. */
+	mov r1, r8
+	movs r0, #50
+	bl auto_cal_timing
+	cmp r0, #4
+	mov r1, r8
+	it lo
+	movlo r0, #4
+	str r0, [sp, #S_TFAW]
+	movs r0, #10
+	bl auto_cal_timing
+	mov r3, r0
+	mov r1, r8
+	cmp r0, #0
+	it eq
+	moveq r3, #1
+	movs r0, #24
+	str r3, [sp, #S_TRRD]
+	bl auto_cal_timing
+	cmp r0, #2
+	mov r1, r8
+	it lo
+	movlo r0, #2
+	str r0, [sp, #S_TRCD]
+	movs r0, #70
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TRC]
+	movs r0, #8
+	bl auto_cal_timing
+	str r0, [sp, #S_TXP]
+	cbz r0, .Llpddr2_minimum_txp
+	cmp r0, #2
+	mov r5, r0
+	it lo
+	movlo r5, #2
+.Llpddr2_write_timing:
+	mov r1, r8
+	movs r0, #15
+	bl auto_cal_timing
+	cmp r0, #2
+	mov r1, r8
+	it lo
+	movlo r0, #2
+	mov r7, r0
+	movs r0, #17
+	bl auto_cal_timing
+	mov r1, r8
+	mov r10, r0
+	movs r0, #42
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TRAS]
+	movw r0, #3900
+	bl auto_cal_timing
+	ands r3, r0, #31
+	mov r1, r8
+	it ne
+	movne r3, #1
+	add r11, r3, r0, lsr #5
+	movs r0, #210
+	bl auto_cal_timing
+	str r0, [sp, #S_TRFC]
+	b .Lpack_calculated_timings
+.Llpddr2_minimum_txp:
+	movs r3, #1
+	movs r5, #2
+	str r3, [sp, #S_TXP]
+	b .Llpddr2_write_timing
+
+.Lcalculate_non_lpddr2:
+	cmp r6, #LPDDR3
+	bne .Lcalculate_default
+	/* LPDDR3 shares refresh limits but uses its own write latency. */
+	mov r1, r8
+	movs r0, #50
+	bl auto_cal_timing
+	cmp r0, #4
+	mov r1, r8
+	it lo
+	movlo r0, #4
+	str r0, [sp, #S_TFAW]
+	movs r0, #10
+	bl auto_cal_timing
+	mov r3, r0
+	mov r1, r8
+	cmp r0, #0
+	it eq
+	moveq r3, #1
+	movs r0, #24
+	str r3, [sp, #S_TRRD]
+	bl auto_cal_timing
+	cmp r0, #2
+	mov r1, r8
+	it lo
+	movlo r0, #2
+	str r0, [sp, #S_TRCD]
+	movs r0, #70
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TRC]
+	movs r0, #8
+	bl auto_cal_timing
+	cmp r0, #2
+	mov r1, r8
+	it lo
+	movlo r0, #2
+	mov r5, r0
+	movs r0, #15
+	bl auto_cal_timing
+	cmp r0, #2
+	mov r1, r8
+	it lo
+	movlo r0, #2
+	mov r7, r0
+	movs r0, #17
+	bl auto_cal_timing
+	mov r1, r8
+	mov r10, r0
+	movs r0, #42
+	bl auto_cal_timing
+	mov r1, r8
+	str r0, [sp, #S_TRAS]
+	movw r0, #3900
+	bl auto_cal_timing
+	ands r3, r0, #31
+	mov r1, r8
+	it ne
+	movne r3, #1
+	add r11, r3, r0, lsr #5
+	movs r0, #210
+	bl auto_cal_timing
+	str r5, [sp, #S_TXP]
+	str r0, [sp, #S_TRFC]
+	b .Lpack_calculated_timings
+.Lcalculate_default:
+	movs r3, #128
+	movs r2, #14
+	str r3, [sp, #S_TRFC]
+	movs r3, #10
+	str r3, [sp, #S_TXP]
+	movs r3, #16
+	movs r5, #3
+	mov r10, #6
+	strd r3, r2, [sp, #S_TFAW]
+	movs r3, #20
+	mov r11, #98
+	movs r7, #8
+	str r3, [sp, #S_TRC]
+	str r10, [sp, #S_TRCD]
+	str r5, [sp, #S_TRRD]
+	b .Lpack_calculated_timings
+
+.Lrefresh_half:
+	ldr r0, =dram_refresh_39ms
+	lsr r11, r11, #1
+.Lrefresh_report:
+	bl printf
+	ldr r3, [sp, #S_TRFC]
+	str r5, [sp, #S_TRTP]
+	orr r3, r11, r3, lsl #12
+	str r3, [r4, #P_TPR2]
+	movs r3, #2
+	str r3, [sp, #S_TCCD]
+	b .Lselect_mode_values
+.Lrefresh_quarter:
+	lsr r11, r11, #2
+	ldr r0, =dram_refresh_195ms
+	b .Lrefresh_report
+/* Refresh diagnostics are the only literals needed by phase one. */
+.p2align 2
+.ltorg
+
+.Lmode_ddr2:
+	/* DDR2 mode values depend on whether the half clock exceeds 204 MHz. */
+	ldr r0, =DIV30_OR60_MULTIPLIER
+	cmp r8, #204
+	it hi
+	movhi r8, r6
+	mov r12, r6
+	mov r6, #3
+	it ls
+	movls r8, #1
+	mov lr, r6
+	umull r0, r1, r9, r0
+	mov r0, #500
+	mul r0, r0, r2
+	lsr r3, r1, #4
+	movw r1, #0x0e73
+	str r3, [sp, #S_TRASMAX]
+	ite hi
+	movhi r3, #4
+	movls r3, #3
+	str r3, [sp, #S_TCL]
+	movw r3, #0x0a63
+	it hi
+	movhi r3, r1
+	str r3, [sp, #S_MR0]
+	mov r3, #400
+	muls r3, r2, r3
+	adds r3, #1
+	str r3, [sp, #S_TDINIT0]
+	ldr r3, =DIV1000_MULTIPLIER
+	umull r0, r1, r0, r3
+	movs r0, #4
+	mov r9, r0
+	lsrs r3, r1, #6
+	movs r1, #5
+	adds r3, #1
+	str r3, [sp, #S_TDINIT1]
+	movs r3, #200
+	muls r3, r2, r3
+	adds r3, #1
+	str r3, [sp, #S_TDINIT2]
+	adds r3, r2, #1
+	str r3, [sp, #S_TDINIT3]
+	adds r3, r7, #5
+	str r3, [sp, #S_TWTP]
+	adds r3, r5, #5
+	str r3, [sp, #S_TWR2RD]
+	movs r5, #1
+	ldr r3, [sp, #S_SAVED_MR1]
+	str r5, [sp, #S_WR_LATENCY]
+	str r3, [sp, #S_FLAGS_OR_MR1]
+	movs r3, #12
+	str r3, [sp, #S_TMOD]
+	movs r3, #0
+	str r3, [sp, #S_MR3]
+	str r3, [sp, #S_MR2]
+
+.Lfinish_mode_values:
+	/* Ensure tRTP+tRP is at least tCL+2. */
+	ldr r5, [sp, #S_TCL]
+	adds r5, #2
+	str r5, [sp, #S_TCL_PLUS2]
+	ldr r5, [sp, #S_TRTP]
+	add r5, r10
+	mov r7, r5
+	ldr r5, [sp, #S_TCL_PLUS2]
+	cmp r7, r5
+	itttt lo
+	ldrlo r7, [sp, #S_TCL]
+	rsblo r5, r10, #2
+	addlo r5, r5, r7
+	strlo r5, [sp, #S_TRTP]
+	/* Preserve caller overrides: upper MR halfwords inhibit replacement. */
+	ldrh r5, [r4, #(P_MR0+2)]
+	cbnz r5, .Lmr0_ready
+	ldr r5, [sp, #S_MR0]
+	str r5, [r4, #P_MR0]
+.Lmr0_ready:
+	ldr r5, [sp, #S_SAVED_MR1]
+	ldrh r7, [r4, #(P_MR2+2)]
+	lsrs r5, r5, #16
+	itt eq
