+.Lscan_initial_error:
+    .word dram_initial_zero_error
+.Lscan_row_message:
+    .word dram_scan_row
+.Lscan_work_mode:
+    .word DRAM_COM_WORK_MODE
+.Lscan_bank_message:
+    .word dram_scan_bank
+.Lscan_page_message:
+    .word dram_scan_page_size
+.Lscan_same_rank_message:
