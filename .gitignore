# Recovery dumps — large binaries, never commit
tools/recovery/*.img
tools/recovery/*.img.gz
tools/recovery/*.img.gz.sha256
tools/recovery/*.size
tools/recovery/.current_dump_name
tools/recovery/.work/

# Vendored third-party (downloaded, never commit; buildroot is a submodule and stays tracked)
/vendor/kernels/linux-5.4.61/
/vendor/kernels/*.tar.xz
/vendor/toolchains/

# Transient build output (top-level, gitignored whole)
/build/
# build-variant.sh generates these alongside the source defconfig.
/br-external/configs/reforge_*_defconfig
*.tar
*.tar.xz
*.tgz

# Editor / OS
*.swp
.DS_Store

# Python bytecode — NEVER track these anywhere in the repo.
# Especially important under br-external/board/reforge/rootfs-overlay/: anything
# under that tree gets copied verbatim into the device rootfs, and a stray
# host-generated __pycache__ would ship to production unless gitignored AND
# scrubbed at build time by post-build.sh.
__pycache__/
*.py[cod]
*$py.class

# Local Python environments and test caches
.venv/
venv/
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
htmlcov/

# Local secrets (keep example templates trackable)
.env
.env.*
!.env.example

# Packaging build artifacts
packaging/dist/
*.img

# qemu-harness build artifacts (zImage, initramfs, build logs — never commit)
tests/qemu-harness/build/

# Lab — experiments / scratch (never ships to github)
lab/scratch/
lab/spike-stockui/extracted/

# Recovery image archive — large third-party blobs (never commit)
tools/recovery/archive/

# graphify knowledge-graph output — regenerable via `graphify update .` (~2 GB)
graphify-out/
