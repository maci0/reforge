# Recovery dumps — large binaries, never commit
tools/recovery/*.img
tools/recovery/*.img.gz
tools/recovery/*.img.gz.sha256
tools/recovery/*.size
tools/recovery/.current_dump_name
tools/recovery/.work/

# Vendored third-party (downloaded, never commit; buildroot is a submodule and stays tracked)
/vendor/kernels/linux-5.4.61/
/vendor/kernels/*.tar.xz
/vendor/toolchains/

# Transient build output (top-level, gitignored whole)
/build/
*.tar
*.tar.xz
*.tgz

# Editor / OS
*.swp
.DS_Store

# Packaging build artifacts
packaging/dist/
*.img

# qemu-harness build artifacts (zImage, initramfs, build logs — never commit)
tests/qemu-harness/build/

# Lab — experiments / scratch (never ships to github)
lab/scratch/
lab/spike-stockui/extracted/

# Recovery image archive — large third-party blobs (never commit)
tools/recovery/archive/
